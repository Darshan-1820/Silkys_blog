---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.config.js';
import { abs } from '../lib/seo.js';

// ─────────────────────────────────────────────────────────────────────────
//  ABOUT — "Silky's desk". A full-bleed top-down desk (Framer-style): her
//  painted objects scattered on wood, gentle cursor parallax, tap an object
//  → a handwritten note flips up. Paper things (intro scrap, sticky, diary
//  sheet, polaroid) are code-drawn; objects are the Nano-Banana paintings
//  cut out to transparency (tools/cutout-desk-art.mjs → /public/desk/).
//
//  ⚑ EDIT HER REAL WORDS: `diary`, `now`, and `favs` below (placeholders).
// ─────────────────────────────────────────────────────────────────────────

const about = { nick: 'Silky', tag: 'writer · reader · overthinker-in-chief' };

const diary = [
  "Hey. I'm Shreya — but everyone just calls me Silky.",
  "I'm a writer, a compulsive reader, and a professional overthinker (it's on the business card, right under “dramatic pauses”). I grew up in Patna finding books boring if they didn't have pictures — and somehow became the kind of person who stays up till 2am to finish a series she swore she'd shut at midnight.",
  "Somewhere along the way I started writing my own. Fiction, mostly. This little corner is where the leftover words end up — the stories, the incidents, the thoughts that were too loud to sleep on.",
  "I don't think the good stuff is built from résumés and job titles. It's curiosity, consistency, and the courage to keep showing up. So — here I am. Showing up. Again.",
];

const now = [
  { k: 'reading', v: 'anything with a body count and a heartbreak' },
  { k: 'writing', v: 'a story I keep almost finishing' },
  { k: 'drinking', v: 'coffee, cold again' },
  { k: 'avoiding', v: 'the draft that’s due' },
];

const favs = {
  smokes: { title: 'the smokes', note: "don't tell mum",
    items: ['Marlboro Red — the classic', 'Marlboro Advance', 'Classic Milds — daytime', 'a stolen one always tastes better'] },
  drinks: { title: 'the drinks', note: 'editing fuel',
    items: ['whisky, neat', 'Old Monk & coke', 'black coffee at 2am', 'cheap red wine', 'chai — always'] },
  books: { title: 'the reading pile', note: 'the guilty, ever-growing stack',
    items: ['The Bell Jar — Sylvia Plath', 'Norwegian Wood — Murakami', 'Milk and Honey — Rupi Kaur', 'anything with a tragic ending'] },
  music: { title: 'on repeat', note: 'scored to heartbreak',
    items: ['TV Girl — everything', 'Cigarettes After Sex', 'Lana Del Rey', 'Arctic Monkeys — AM', 'old Bollywood at 3am'] },
  movies: { title: 'the movies', note: 'watched too many times',
    items: ['Eternal Sunshine of the Spotless Mind', 'Call Me By Your Name', 'anything Wong Kar-wai', '500 Days of Summer', 'Jab We Met — comfort watch'] },
  flowers: { title: 'the flowers', note: 'the ones that dry pretty',
    items: ['white tulips', "baby's breath", 'sunflowers — on good days', 'carnations', 'dried roses'] },
};

// painted objects on the desk: cat → note data above; label under each object
const objects = [
  { cat: 'flowers', src: '/desk/flowers.webp',  label: 'the flowers',  cls: 'o-flowers' },
  { cat: 'drinks',  src: '/desk/coffee.webp',   label: 'the drinks',   cls: 'o-coffee' },
  { cat: 'music',   src: '/desk/cassette.webp', label: 'on repeat',    cls: 'o-cassette' },
  { cat: 'smokes',  src: '/desk/smokes.webp',   label: 'the smokes',   cls: 'o-smokes' },
  { cat: 'books',   src: '/desk/books.webp',    label: 'the books',    cls: 'o-books' },
  { cat: 'movies',  src: '/desk/tickets.webp',  label: 'the movies',   cls: 'o-tickets' },
];

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: `About ${about.nick}`, url: abs(Astro, '/about'),
  mainEntity: { '@type': 'Person', name: 'Shreya Silky', alternateName: 'Silky', jobTitle: 'Writer', url: abs(Astro, '/') },
}];
---
<Base
  title={`About — ${site.brand.name} ${site.brand.mark}`}
  description="Shreya (Silky) — writer, reader, overthinker-in-chief. Her desk, her things, her story."
  jsonld={jsonld}
>
<main id="about">

  <section class="desk" aria-label="Silky's garden — tap the things in it">
    <div class="desk-top" id="deskTop">

      <!-- intro scrap -->
      <header class="dobj paper d-intro" data-depth="0.4" style="--r:-1.6deg">
        <span class="tape" style="top:-12px;left:50%;margin-left:-42px;transform:rotate(-3deg)"></span>
        <span class="sticker">about</span>
        <h1 class="d-name">Hi, I'm {about.nick}.</h1>
        <p class="d-tag">{about.tag}</p>
        <p class="d-hint">this is my little garden. tap my things ↓</p>
      </header>

      <!-- her photo, cut out as a sticker — tap → the long version -->
      <button class="dobj dart obj-btn o-me" data-cat="diary" data-depth="1.15" style="--r:-4deg" aria-label="Read Silky's story — the long version">
        <img src="/desk/silky.webp" alt="Silky" loading="eager" decoding="async" />
        <span class="d-lbl">read my story →</span>
      </button>

      <!-- currently sticky -->
      <aside class="dobj d-sticky" data-depth="0.8" style="--r:2deg">
        <h3>currently</h3>
        <ul>
          {now.map((n) => <li><span class="k">{n.k}</span><span class="v">{n.v}</span></li>)}
        </ul>
      </aside>

      <!-- painted objects -->
      {objects.map((o) => (
        <button class={`dobj dart obj-btn ${o.cls}`} data-cat={o.cat} data-depth="1" aria-label={`Silky's ${o.label}`}>
          <img src={o.src} alt="" loading="eager" decoding="async" />
          <span class="d-lbl">{o.label}</span>
        </button>
      ))}

    </div>
  </section>

  <div class="ab-cta">
    <a class="read-cta" href="/#wall" style="display:inline-block;text-decoration:none">now read the diary →</a>
  </div>

  <!-- notes data (hidden; cloned on tap) -->
  <div id="deskData" hidden>
    {Object.entries(favs).map(([cat, d]) => (
      <div class="dset" data-cat={cat}>
        <h3>{d.title}</h3>
        {d.note && <p class="dc-note">“{d.note}”</p>}
        <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
    <div class="dset" data-cat="diary">
      <figure class="dc-photo"><img src="/silky.jpg" alt="Silky" width="680" height="850" /><figcaption>me, mid-overthink</figcaption></figure>
      <h3>the long version</h3>
      {diary.map((p) => <p class="dc-p">{p}</p>)}
      <p class="dc-sign">— {about.nick} ✷</p>
    </div>
  </div>

  <!-- the note that flips up -->
  <div id="deskCard" class="desk-card" aria-hidden="true">
    <div class="dc-inner" role="dialog" aria-modal="true">
      <span class="tape" style="top:-12px;left:40px;transform:rotate(-5deg)"></span>
      <span class="tape" style="top:-12px;right:40px;transform:rotate(6deg)"></span>
      <button class="dc-close" type="button" aria-label="close">✕</button>
      <div class="dc-body"></div>
    </div>
  </div>

</main>

<script is:inline>
  (() => {
    // ── note card (tap object → flip up) ──
    const card = document.getElementById('deskCard');
    if (!card) return;
    const body = card.querySelector('.dc-body');
    const data = {};
    document.querySelectorAll('#deskData .dset').forEach((d) => { data[d.dataset.cat] = d.innerHTML; });
    let lastFocus = null;
    function open(cat, trigger) {
      if (!data[cat]) return;
      lastFocus = trigger || null; body.innerHTML = data[cat];
      card.classList.add('open'); card.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; card.querySelector('.dc-close').focus();
    }
    function close() {
      card.classList.remove('open'); card.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; if (lastFocus) lastFocus.focus();
    }
    document.querySelectorAll('.obj-btn').forEach((b) => b.addEventListener('click', () => open(b.dataset.cat, b)));
    card.addEventListener('click', (e) => { if (e.target === card || e.target.closest('.dc-close')) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && card.classList.contains('open')) close(); });

    // ── cursor parallax (fine pointers only, respects reduced motion) ──
    const desk = document.querySelector('.desk');
    const layers = [...document.querySelectorAll('.dobj[data-depth]')];
    const fine = matchMedia('(pointer: fine)').matches;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (desk && fine && !still) {
      let raf = 0, nx = 0, ny = 0;
      desk.addEventListener('pointermove', (e) => {
        const r = desk.getBoundingClientRect();
        nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
        if (!raf) raf = requestAnimationFrame(() => {
          raf = 0;
          for (const el of layers) {
            const d = parseFloat(el.dataset.depth || '1');
            el.style.setProperty('--tx', `${(-nx * 9 * d).toFixed(1)}px`);
            el.style.setProperty('--ty', `${(-ny * 7 * d).toFixed(1)}px`);
          }
        });
      });
      desk.addEventListener('pointerleave', () => {
        for (const el of layers) { el.style.setProperty('--tx', '0px'); el.style.setProperty('--ty', '0px'); }
      });
    }
  })();
</script>

<style>
  #about { padding-bottom: 40px; }

  /* ── the scene: her painted garden, top-down — graded + spotlit ── */
  .desk {
    position: relative; overflow: hidden;
    height: max(86vh, 760px);
    background: #8a6a48;
  }
  /* the painting, pushed BACK — muted so it reads as a backdrop, not the star */
  .desk::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    background: url('/desk/garden.webp') center / cover no-repeat;
    filter: saturate(.82) brightness(.86) contrast(1.02);
  }
  /* soft centre light + strong vignette so objects sit in a pool of light */
  .desk::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(75% 60% at 50% 42%, rgba(255,240,205,.14), rgba(255,240,205,0) 60%),
      radial-gradient(125% 105% at 50% 44%, transparent 34%, rgba(20,9,2,.62) 100%);
  }
  [data-theme="night"] .desk { background: #1a1530; }
  [data-theme="night"] .desk::before { filter: saturate(.8) brightness(.5) contrast(1.06); }
  [data-theme="night"] .desk::after {
    background:
      radial-gradient(70% 55% at 50% 38%, rgba(150,160,255,.20), transparent 60%),
      linear-gradient(rgba(20,14,44,.5), rgba(20,14,44,.5)),
      radial-gradient(130% 105% at 50% 44%, transparent 38%, rgba(8,4,26,.72) 100%);
  }
  .desk-top { position: absolute; inset: 0; z-index: 2; }

  /* ── shared object behaviour ── */
  .dobj {
    position: absolute;
    transform: translate(var(--tx, 0), var(--ty, 0)) rotate(var(--r, 0deg));
    transition: transform .18s ease-out;
    animation: settle .5s var(--ease) backwards;
  }
  .dobj:nth-child(2) { animation-delay: .05s } .dobj:nth-child(3) { animation-delay: .1s }
  .dobj:nth-child(4) { animation-delay: .15s } .dobj:nth-child(5) { animation-delay: .2s }
  .dobj:nth-child(6) { animation-delay: .25s } .dobj:nth-child(7) { animation-delay: .3s }
  .dobj:nth-child(8) { animation-delay: .35s } .dobj:nth-child(9) { animation-delay: .4s }
  .dobj:nth-child(10) { animation-delay: .45s }
  @keyframes settle { from { opacity: 0; transform: translate(0, -14px) rotate(var(--r, 0deg)) scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .dobj { animation: none; } }

  button.dobj { border: 0; padding: 0; cursor: pointer; text-align: left; }
  button.dart { background: none; }
  button.dobj:focus-visible { outline: 3px dashed var(--paper); outline-offset: 6px; }

  /* painted objects = die-cut STICKERS — a crisp white edge peels them off the
     garden, then a deep contact shadow floats them. This is what makes them pop. */
  .dart img { position: relative; z-index: 1; display: block; width: 100%; height: auto;
    --stk: #fbf7ec;
    filter:
      drop-shadow(2.5px 0 0 var(--stk)) drop-shadow(-2.5px 0 0 var(--stk))
      drop-shadow(0 2.5px 0 var(--stk)) drop-shadow(0 -2.5px 0 var(--stk))
      drop-shadow(1.8px 1.8px 0 var(--stk)) drop-shadow(-1.8px 1.8px 0 var(--stk))
      drop-shadow(1.8px -1.8px 0 var(--stk)) drop-shadow(-1.8px -1.8px 0 var(--stk))
      drop-shadow(7px 15px 15px rgba(20,9,2,.6));
    transition: transform .24s var(--ease), filter .24s var(--ease); }
  .dart:hover img, .dart:focus-visible img { transform: translateY(-8px) scale(1.06);
    filter:
      drop-shadow(2.5px 0 0 var(--stk)) drop-shadow(-2.5px 0 0 var(--stk))
      drop-shadow(0 2.5px 0 var(--stk)) drop-shadow(0 -2.5px 0 var(--stk))
      drop-shadow(1.8px 1.8px 0 var(--stk)) drop-shadow(-1.8px 1.8px 0 var(--stk))
      drop-shadow(1.8px -1.8px 0 var(--stk)) drop-shadow(-1.8px -1.8px 0 var(--stk))
      drop-shadow(11px 26px 28px rgba(20,9,2,.62)); }
  [data-theme="night"] .dart img { --stk: #ece7f6; }
  /* label = a little pink pill that pops on the busy garden */
  .d-lbl { position: absolute; z-index: 2; left: 50%; bottom: -14px; transform: translateX(-50%) rotate(-1.5deg) scale(.9);
    font-family: var(--hand); font-size: .82rem; white-space: nowrap; color: #fff;
    background: var(--pink); padding: 3px 11px 4px; border-radius: 20px; line-height: 1;
    box-shadow: 2px 3px 0 var(--blue), 0 6px 14px rgba(30,14,4,.35);
    opacity: 0; transition: opacity .2s, transform .22s var(--ease); pointer-events: none; }
  .dart:hover .d-lbl, .dart:focus-visible .d-lbl { opacity: 1; transform: translateX(-50%) rotate(-1.5deg) scale(1) translateY(6px); }

  /* ── paper things (code-drawn, same collage language) ── */
  .dobj.paper { background: var(--card);
    box-shadow: 5px 14px 30px rgba(25,10,2,.48), 0 0 34px 6px rgba(255,239,206,.35); }
  [data-theme="night"] .dobj.paper { box-shadow: 5px 14px 30px rgba(0,0,0,.55), 0 0 34px 6px rgba(190,200,255,.22); }

  .d-intro { left: 3.5%; top: 6%; width: min(330px, 42vw); padding: 26px 26px 22px; }
  .d-intro .sticker { font-size: .85rem; }
  .d-name { font-family: var(--marker); font-weight: 700; color: var(--pink);
    font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: .95; margin: 10px 0 8px; text-shadow: 1.5px 1.5px 0 var(--blue); }
  .d-tag { font-family: var(--hand); font-size: .98rem; color: var(--blue); }
  .d-hint { font-family: var(--hand); font-size: .9rem; color: var(--ink-soft); margin-top: 12px; transform: rotate(-1deg); }

  /* her photo-sticker — under the intro, on the LEFT; tap → the long version */
  .o-me { left: 5%; top: 33%; width: clamp(140px, 12.5vw, 182px); }

  .d-sticky { left: 4%; bottom: 5%; width: clamp(180px, 16vw, 220px); background: #f7e58a;
    padding: 18px 20px; box-shadow: 3px 8px 20px rgba(25,10,2,.35); }
  [data-theme="night"] .d-sticky { background: #d8c76a; }
  .d-sticky h3 { font-family: var(--sticker); text-transform: uppercase; font-size: .95rem; color: #3a2f10; letter-spacing: .04em; margin-bottom: 9px; transform: rotate(-1.5deg); }
  .d-sticky ul { list-style: none; display: flex; flex-direction: column; gap: 7px; }
  .d-sticky li { display: flex; flex-direction: column; }
  .d-sticky .k { font-family: var(--grotesk); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: #8a6a1a; }
  .d-sticky .v { font-family: var(--type); font-size: .82rem; color: #2a2410; line-height: 1.3; }

  /* ── painted-object positions (desktop) — spread evenly across the scene ── */
  .o-flowers  { left: 39%; top: 5%;  width: clamp(120px, 11vw, 170px); --r: 6deg; }
  .o-coffee   { left: 69%; top: 8%;  width: clamp(120px, 11vw, 165px); --r: 0deg; }
  .o-cassette { left: 46%; top: 40%; width: clamp(140px, 13vw, 195px); --r: -7deg; }
  .o-smokes   { left: 78%; top: 33%; width: clamp(120px, 11vw, 165px); --r: 9deg; }
  .o-books    { left: 65%; top: 60%; width: clamp(165px, 15vw, 235px); --r: -3deg; }
  .o-tickets  { left: 40%; top: 62%; width: clamp(150px, 14vw, 210px); --r: -8deg; }

  .ab-cta { text-align: center; padding: 34px 0 10px; }

  /* ── note card — opens with a soft rise ── */
  .desk-card { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center;
    padding: 24px; visibility: hidden; opacity: 0; pointer-events: none;
    background: radial-gradient(120% 120% at 50% 30%, rgba(40,20,60,.5), rgba(12,8,22,.72));
    backdrop-filter: blur(7px) saturate(1.1);
    transition: opacity .3s ease, visibility .3s ease; }
  .desk-card.open { visibility: visible; opacity: 1; pointer-events: auto; }
  .dc-inner { position: relative; background: var(--card); width: min(460px, 92vw); max-height: 86vh; overflow: auto;
    padding: 34px 32px 30px; border-radius: 3px;
    box-shadow: 0 30px 80px rgba(0,0,0,.55), 0 2px 0 rgba(255,255,255,.4) inset;
    background-image:
      linear-gradient(color-mix(in srgb, var(--pink) 12%, transparent), transparent 120px),
      repeating-linear-gradient(var(--card) 0 31px, color-mix(in srgb, var(--blue) 14%, transparent) 31px 32px);
    transform: translateY(28px) scale(.94) rotate(-1.4deg); opacity: 0;
    transition: transform .44s cubic-bezier(.2,.85,.25,1.05), opacity .34s ease; }
  .desk-card.open .dc-inner { transform: translateY(0) scale(1) rotate(-1.2deg); opacity: 1; }
  .dc-inner::-webkit-scrollbar { width: 8px; } .dc-inner::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--pink) 40%, transparent); border-radius: 8px; }
  @media (prefers-reduced-motion: reduce) { .dc-inner { transition: opacity .2s; transform: rotate(-1.2deg); } .desk-card.open .dc-inner { transform: rotate(-1.2deg); } }
  .dc-close { position: sticky; top: 0; float: right; background: var(--ink); color: var(--paper); border: 0; border-radius: 50%;
    width: 32px; height: 32px; cursor: pointer; font-size: .95rem; line-height: 1; z-index: 3;
    box-shadow: 2px 3px 0 var(--pink); transition: transform .15s, background .15s; }
  .dc-close:hover { background: var(--pink); box-shadow: 2px 3px 0 var(--blue); transform: rotate(90deg); }

  /* photo on top of the long version */
  .dc-body :global(.dc-photo) { float: none; margin: 2px auto 20px; width: 62%; max-width: 220px;
    background: #fff; padding: 9px 9px 12px; box-shadow: 0 12px 30px rgba(20,10,2,.35); transform: rotate(-3deg); }
  .dc-body :global(.dc-photo img) { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: 34% 24%; }
  .dc-body :global(.dc-photo figcaption) { font-family: var(--marker); font-weight: 700; font-size: 1rem; color: #222; text-align: center; margin-top: 6px; }

  .dc-body :global(h3) { font-family: var(--marker); font-weight: 700; font-size: 2.6rem; color: var(--pink);
    text-shadow: 2px 2px 0 var(--blue); line-height: .95; margin-bottom: 6px; position: relative; display: inline-block; clear: both; }
  .dc-body :global(h3)::after { content: ''; display: block; height: 7px; margin-top: 3px; border-radius: 6px;
    background: color-mix(in srgb, var(--pink) 35%, transparent); transform: rotate(-.6deg) scaleX(.96); transform-origin: left; }
  .dc-body :global(.dc-note) { font-family: var(--hand); font-size: 1rem; color: var(--blue); margin: 6px 0 20px;
    display: inline-block; background: color-mix(in srgb, var(--blue) 10%, transparent); padding: 4px 12px; border-radius: 14px; transform: rotate(-1deg); }
  .dc-body :global(ul) { list-style: none; display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
  .dc-body :global(li) { font-family: var(--type); font-size: 1rem; color: var(--ink); line-height: 1.45;
    padding: 9px 10px 9px 34px; position: relative; border-radius: 8px; transition: background .16s, transform .16s; }
  .dc-body :global(li) + :global(li) { box-shadow: 0 -1px 0 color-mix(in srgb, var(--ink) 10%, transparent); }
  .dc-body :global(li)::before { content: "✦"; position: absolute; left: 12px; top: 9px; color: var(--pink); font-size: 1.05rem; }
  .dc-body :global(li):hover { background: color-mix(in srgb, var(--pink) 9%, transparent); transform: translateX(3px); }
  .dc-body :global(.dc-p) { font-family: var(--type); font-size: .95rem; line-height: 30px; color: var(--ink); margin-bottom: 12px; }
  .dc-body :global(.dc-p):first-of-type::first-letter { font-family: var(--marker); font-weight: 700; font-size: 3.1rem; float: left;
    line-height: .7; margin: 6px 8px 0 0; color: var(--blue); }
  .dc-body :global(.dc-sign) { font-family: var(--marker); font-weight: 700; font-size: 1.7rem; color: var(--blue);
    transform: rotate(-2deg); margin-top: 12px; text-align: right; }

  /* ── mobile: taller desk, everything repositioned by hand ── */
  @media (max-width: 720px) {
    .desk { height: 1160px; }
    .d-intro   { left: 4%;  top: 1.5%; width: 62vw; padding: 18px 18px 14px; }
    .o-flowers { left: 66%; top: 2%;   width: 30vw; }
    .o-me      { left: 5%;  top: 16%;  width: 40vw; }
    .o-coffee  { left: 60%; top: 17%;  width: 36vw; --r: -4deg; }
    .o-cassette{ left: 7%;  top: 37%;  width: 46vw; }
    .o-smokes  { left: 64%; top: 38%;  width: 33vw; }
    .d-sticky  { left: 6%;  top: 57%;  bottom: auto; width: 50vw; }
    .o-books   { left: 56%; top: 55%;  width: 40vw; }
    .o-tickets { left: 24%; top: 74%;  width: 52vw; }
    .o-me .d-lbl { display: block; position: static; opacity: 1; transform: none; margin: 8px auto 0; width: max-content; }
    .d-lbl { display: none; }
  }
</style>
</Base>
