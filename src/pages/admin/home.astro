---
import Admin from '../../layouts/Admin.astro';
import { guard } from '../../lib/auth.js';
import { getSectionsForAdmin } from '../../lib/sections.js';
import { SECTION_TYPES, TYPE_ORDER } from '../../lib/section-types.js';

const denied = await guard(Astro);
if (denied) return denied;

const { DB } = Astro.locals.runtime.env;
const sections = await getSectionsForAdmin(DB);
// one section per kind: remember which types already exist
const existingByType = {};
for (const s of sections) if (existingByType[s.type] === undefined) existingByType[s.type] = s.id;
---
<Admin title="your homepage">
<div class="desk">
  <div class="row" style="justify-content:space-between;margin-bottom:8px">
    <div class="adm-h">your homepage</div>
    <div class="row">
      <a class="btn ghost" href="/admin">✎ stories</a>
      <a class="btn ghost" href="/" target="_blank">view site ↗</a>
      <form method="post" action="/api/logout"><button class="btn ghost" type="submit">sign out</button></form>
    </div>
  </div>
  <p class="adm-sub" style="margin-bottom:22px">the sections below appear top-to-bottom on your homepage. drag isn't needed — use ↑ ↓ to reorder. hide a section to work on it privately.</p>

  <!-- add a section -->
  <div class="panel" style="margin-bottom:22px">
    <div class="note-h" style="font-size:1.3rem;margin-bottom:12px">+ add a section</div>
    <div class="type-picker">
      {TYPE_ORDER.map((t) => {
        const has = existingByType[t];
        return (
          <button class={`type-btn${has ? ' has' : ''}`} type="button" data-type={t} data-existing={has ? String(has) : ''}>
            <b>{SECTION_TYPES[t].label}{has ? <span class="added-badge">✓ added</span> : null}</b>
            <span>{has ? 'open it to add more →' : SECTION_TYPES[t].hint}</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- current sections -->
  {sections.length === 0 ? (
    <div class="panel"><p style="font-family:var(--type);color:var(--ink-soft)">no sections yet — add one above.</p></div>
  ) : (
    <div class="sec-list">
      {sections.map((s, i) => (
        <div class="sec-row" data-id={s.id}>
          <div class="reorder">
            <button class="rbtn" type="button" data-move="up" disabled={i === 0}>↑</button>
            <button class="rbtn" type="button" data-move="down" disabled={i === sections.length - 1}>↓</button>
          </div>
          <div class="sec-info">
            <div class="sec-kind">{SECTION_TYPES[s.type] ? SECTION_TYPES[s.type].label : s.type}</div>
            <div class="sec-name">{s.heading || s.subhead || <em style="color:var(--ink-soft)">untitled</em>}</div>
          </div>
          <span class={`chip${s.status === 'published' ? ' live' : ''}`}>{s.status === 'published' ? 'shown' : 'hidden'}</span>
          <div class="row">
            <button class="btn ghost small" type="button" data-toggle data-status={s.status}>{s.status === 'published' ? 'hide' : 'show'}</button>
            <a class="btn ghost small" href={`/admin/section/${s.id}`}>edit</a>
            <button class="btn ghost small danger" type="button" data-del>delete</button>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .type-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
  .type-btn{text-align:left;cursor:pointer;background:var(--paper);border:2px solid var(--ink);padding:11px 13px;
    box-shadow:2px 3px 0 rgba(0,0,0,.16);transition:transform .1s,box-shadow .1s}
  .type-btn:hover{transform:translate(-1px,-1px);box-shadow:3px 4px 0 rgba(0,0,0,.2)}
  .type-btn.has{background:var(--card)}
  .added-badge{font-family:var(--type);font-size:.64rem;color:var(--blue);margin-left:6px;font-weight:normal}
  .type-btn b{display:block;font-family:var(--grotesk);font-size:.95rem}
  .type-btn span{display:block;font-family:var(--type);font-size:.76rem;color:var(--ink-soft);margin-top:3px}
  .sec-list{display:flex;flex-direction:column;gap:10px}
  .sec-row{display:flex;align-items:center;gap:14px;background:var(--card);border:2px solid var(--ink);
    padding:12px 14px;box-shadow:3px 4px 0 rgba(34,34,201,.1)}
  .reorder{display:flex;flex-direction:column;gap:2px}
  .rbtn{cursor:pointer;background:var(--paper);border:1.5px solid var(--ink);width:26px;height:20px;line-height:1;font-size:.8rem}
  .rbtn:disabled{opacity:.3;cursor:default}
  .sec-info{flex:1;min-width:0}
  .sec-kind{font-family:var(--hand);font-size:.72rem;color:var(--blue)}
  .sec-name{font-family:var(--grotesk);font-size:1.05rem;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .btn.small{padding:6px 11px;font-size:.76rem;box-shadow:2px 2px 0 rgba(0,0,0,.2)}
  .btn.small.danger{color:var(--pink-deep)}
  @media(max-width:640px){.sec-name{white-space:normal}}
</style>

<script>
  async function post(url, body) {
    return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body || {}) });
  }
  // add section -> create draft -> open editor
  document.querySelectorAll('.type-btn').forEach((b) => b.addEventListener('click', async () => {
    // already have this kind? open it to add more, don't make a duplicate
    if (b.dataset.existing) { window.location.href = `/admin/section/${b.dataset.existing}`; return; }
    b.disabled = true;
    const r = await post('/api/sections', { type: b.dataset.type });
    if (r.ok) { const { id } = await r.json(); window.location.href = `/admin/section/${id}`; }
    else { b.disabled = false; alert('could not add section'); }
  }));
  // row actions
  document.querySelectorAll('.sec-row').forEach((row) => {
    const id = row.dataset.id;
    row.querySelectorAll('[data-move]').forEach((btn) => btn.addEventListener('click', async () => {
      await post(`/api/sections/${id}`, { dir: btn.dataset.move });
      window.location.reload();
    }));
    const toggle = row.querySelector('[data-toggle]');
    if (toggle) toggle.addEventListener('click', async () => {
      const next = toggle.dataset.status === 'published' ? 'draft' : 'published';
      // send just status; server keeps the rest via a partial-safe update
      await fetch(`/api/sections/${id}`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ statusOnly: true, status: next }) });
      window.location.reload();
    });
    const del = row.querySelector('[data-del]');
    if (del) del.addEventListener('click', async () => {
      if (!confirm('delete this section?')) return;
      await fetch(`/api/sections/${id}`, { method: 'DELETE' });
      window.location.reload();
    });
  });
</script>
</Admin>
