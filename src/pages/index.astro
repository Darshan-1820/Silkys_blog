---
import Base from '../layouts/Base.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { getAllPosts } from '../lib/posts.js';
import { getSections, getSectionsForAdmin } from '../lib/sections.js';
import { isAuthed } from '../lib/auth.js';

const { DB } = Astro.locals.runtime.env;
const preview = Astro.url.searchParams.has('preview') && (await isAuthed(Astro));
const [posts, sections] = await Promise.all([
  getAllPosts(DB),
  preview ? getSectionsForAdmin(DB) : getSections(DB),
]);
---
<Base preview={preview}>
<main id="home">
  {sections.map((section) => <SectionRenderer section={section} posts={posts} />)}

  <!-- SUBSCRIBE (site feature, always at the foot) -->
  <section class="wrap" id="sub">
    <span class="tape" style="top:-13px;left:60px;transform:rotate(-6deg)"></span>
    <span class="tape" style="top:-13px;right:80px;transform:rotate(7deg)"></span>
    <svg class="scatter" style="right:-30px;bottom:-30px;width:80px;height:80px;transform:rotate(10deg)" viewBox="0 0 100 100" fill="var(--pink)"><path d="M50 84 C6 54 16 14 50 36 C84 14 94 54 50 84 Z"/></svg>
    <div class="sub rv">
      <h2>get new stories<br>when the ink dries.</h2>
      <svg class="scribble" viewBox="0 0 340 16" preserveAspectRatio="none" style="max-width:300px"><path d="M4 11 q40 -9 80 -3 q50 7 96 -2 q56 -10 104 1 q30 6 52 -1" stroke="var(--pink)"/></svg>
      <p>no schedule, no spam. just a note when something new is scribbled down.</p>
      <form onsubmit="return false">
        <input type="email" placeholder="your@email.com" aria-label="email">
        <button type="submit">subscribe ✷</button>
      </form>
    </div>
  </section>
</main>
</Base>
