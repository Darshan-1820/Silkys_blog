---
import '../styles/global.css';
const { title = 'the writing desk', showNav = true } = Astro.props;
const path = Astro.url.pathname;
const isDesk = path === '/admin' || path === '/admin/';
const isHome = path.startsWith('/admin/home') || path.startsWith('/admin/section');
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} — moonlit</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Gloria+Hallelujah&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style is:global>
  body{min-height:100vh;background-image:linear-gradient(rgba(43,40,120,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(43,40,120,.06) 1px,transparent 1px);background-size:26px 26px}
  .admin-nav{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;
    padding:11px 22px;border-bottom:2.5px dashed rgba(34,34,201,.3);max-width:1120px;margin:0 auto}
  .an-brand{font-family:var(--marker);font-size:1.5rem;color:var(--ink);text-decoration:none;white-space:nowrap}
  .an-brand span{color:var(--pink)}
  .an-links{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
  .an-links a,.an-links button{font-family:var(--type);font-size:.85rem;color:var(--ink);text-decoration:none;
    padding:6px 12px;border:2px solid transparent;cursor:pointer;background:none;line-height:1}
  .an-links a:hover,.an-links button:hover{border-color:var(--ink)}
  .an-links a.on{background:var(--ink);color:var(--paper)}
  .desk{max-width:900px;margin:0 auto;padding:32px 24px 80px}
  .desk.narrow{max-width:460px;display:flex;flex-direction:column;justify-content:center;min-height:100vh}
  .panel{position:relative;background:var(--card);border:3px solid var(--ink);
    box-shadow:6px 9px 0 rgba(34,34,201,.16);padding:34px 30px}
  .panel .tape{left:50%;top:-13px;transform:translateX(-50%) rotate(-3deg)}
  .adm-h{font-family:var(--marker);font-size:2.4rem;line-height:1;color:var(--ink)}
  .adm-sub{font-family:var(--type);color:var(--ink-soft);font-size:.9rem;margin-top:6px}
  label.fld{display:block;margin:18px 0 0}
  label.fld > span{display:block;font-family:var(--hand);font-size:.82rem;color:var(--blue);margin-bottom:6px}
  .in{width:100%;font-family:var(--type);font-size:1rem;padding:11px 13px;background:var(--paper);
    border:2px solid var(--ink);color:var(--ink);outline:none}
  .in:focus{border-color:var(--pink);box-shadow:2px 3px 0 rgba(229,20,123,.25)}
  select.in{cursor:pointer}
  .btn{font-family:var(--sticker);letter-spacing:.04em;text-transform:uppercase;cursor:pointer;
    background:var(--pink);color:#fff;border:2px solid var(--ink);padding:11px 22px;font-size:1rem;
    box-shadow:3px 4px 0 rgba(0,0,0,.28);transition:transform .12s var(--ease),box-shadow .12s var(--ease)}
  .btn:hover{transform:translate(-1px,-1px);box-shadow:4px 5px 0 rgba(0,0,0,.3)}
  .btn:active{transform:translate(1px,2px);box-shadow:1px 2px 0 rgba(0,0,0,.28)}
  .btn.blue{background:var(--blue)}
  .btn.ghost{background:transparent;color:var(--ink);box-shadow:none}
  .btn.ghost:hover{color:var(--pink)}
  .row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
  .err{margin-top:14px;font-family:var(--type);color:var(--pink-deep);background:rgba(229,20,123,.08);
    border:1.5px dashed var(--pink);padding:8px 12px;font-size:.88rem}
  a.link{color:var(--blue);text-decoration:none;border-bottom:1.5px solid var(--blue)}
  a.link:hover{color:var(--pink);border-color:var(--pink)}
  .chip{font-family:var(--sticker);font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:#fff;background:#8a8698;padding:3px 10px 4px;transform:rotate(-2deg);white-space:nowrap}
  .chip.live{background:var(--blue)}
  .note-h{font-family:var(--marker);font-size:1.5rem;color:var(--ink)}
  .note-foot{margin-top:20px;border-top:1.5px dashed rgba(24,22,34,.25);padding-top:12px}
  .check{display:flex;align-items:center;gap:9px;font-family:var(--type);font-size:.9rem;cursor:pointer}
  .check input{width:18px;height:18px;accent-color:var(--pink)}
</style>
</head>
<body data-theme="day">
{showNav && (
  <nav class="admin-nav">
    <a class="an-brand" href="/admin">moonlit<span> · studio</span></a>
    <div class="an-links">
      <a href="/admin" class={isDesk ? 'on' : ''}>✎ the desk</a>
      <a href="/admin/home" class={isHome ? 'on' : ''}>▤ your homepage</a>
      <a href="/admin/comments" class={path.startsWith('/admin/comments') ? 'on' : ''}>💬 comments</a>
      <a href="/" target="_blank" rel="noopener">view site ↗</a>
      <form method="post" action="/api/logout"><button type="submit">sign out</button></form>
    </div>
  </nav>
)}
<slot />
</body>
</html>
