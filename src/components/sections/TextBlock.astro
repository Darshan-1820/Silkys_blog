---
import MoodDoodle from '../MoodDoodle.astro';
import Interactions from '../Interactions.astro';
import { MOOD_LABEL } from '../../lib/moods.js';
const { section } = Astro.props;
const d = section.data || {};
const isQuote = section.type === 'quote' || section.design === 'quote';

// Feed of entries (newest first). Back-compat: an old single-block note becomes one entry.
let entries = Array.isArray(d.entries) ? d.entries.filter((e) => e && e.body_html) : [];
if (!entries.length && d.body_html) entries = [{ date: '', body_html: d.body_html }];
entries = [...entries].sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));

function fmt(dateStr) {
  if (!dateStr) return '';
  const dt = new Date(dateStr);
  return isNaN(dt) ? '' : dt.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
}
---
{isQuote ? (
  <section class="spread wrap rv">
    <svg class="doodle" style="top:40px;left:6%;width:70px;height:70px" viewBox="0 0 60 60" fill="var(--pink)"><path d="M30 2 L36 24 L58 30 L36 36 L30 58 L24 36 L2 30 L24 24 Z"/></svg>
    <svg class="doodle" style="bottom:40px;right:8%;width:54px;height:54px" viewBox="0 0 60 60" fill="var(--blue)"><path d="M30 6 L35 25 L54 30 L35 35 L30 54 L25 35 L6 30 L25 25 Z"/></svg>
    <blockquote>{d.quote}</blockquote>
    {d.by && <div class="by">— {d.by}</div>}
  </section>
) : (
  <section class="wrap txt-feed rv">
    <div class="sec-head"><h2>{section.heading || 'venting place'}</h2><span class="line"></span>
      {section.subhead && <span class="sticker" style="font-size:.82rem">{section.subhead}</span>}
    </div>
    {entries.length === 0 ? (
      <p class="sec-empty">nothing let out yet…</p>
    ) : (
      <div class="vents">
        {entries.map((e) => (
          <article class="vent">
            <div class="vent-mood">
              <MoodDoodle mood={e.mood || 'calm'} size={56} />
              {e.mood && <span class="mood-name">{MOOD_LABEL[e.mood] || e.mood}</span>}
            </div>
            <div class="vent-body">
              {fmt(e.date) && <div class="vent-date">{fmt(e.date)}</div>}
              <div class="txt-body" set:html={e.body_html}></div>
              <Interactions target={`vent:${section.id}:${e.id || e.date}`} />
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .txt-feed{margin:64px auto;max-width:780px}
  .sec-empty{font-family:var(--type);color:var(--ink-soft);text-align:center;padding:24px}
  .vents{display:flex;flex-direction:column;gap:20px;margin-top:26px}
  .vent{display:flex;gap:18px;align-items:flex-start;position:relative;background:#F6EFC7;
    border:2px solid rgba(24,22,34,.45);padding:20px 22px;box-shadow:4px 6px 0 rgba(34,34,201,.12)}
  .vent:nth-child(even){transform:rotate(-.5deg)} .vent:nth-child(odd){transform:rotate(.4deg)}
  [data-theme="night"] .vent{background:#332f28}
  .vent-mood{flex:none;width:72px;text-align:center}
  .mood-name{display:block;font-family:var(--hand);font-size:.74rem;color:var(--blue);margin-top:2px}
  .vent-body{flex:1;min-width:0}
  .vent-date{font-family:var(--marker);font-size:1.2rem;color:var(--pink-deep);margin-bottom:6px}
  @media(max-width:520px){.vent{gap:12px;padding:16px} .vent-mood{width:56px}}
  .txt-body{font-family:var(--type);line-height:1.8}
  .txt-body :global(p)+ :global(p){margin-top:.7em}
  .txt-body :global(img){max-width:100%;height:auto;border:4px solid var(--card);box-shadow:3px 5px 14px rgba(0,0,0,.18)}
</style>
