---
import '../styles/global.css';
import { SITE, abs } from '../lib/seo.js';
import { site } from '../config/site.config.js';
import ThemeVars from '../components/ThemeVars.astro';

const {
  title = SITE.title,
  description = SITE.description,
  preview = false,
  image,
  type = 'website',
  noindex = false,
  published,
  modified,
  section,
  tags = [],
  jsonld = [],
} = Astro.props;

const canonical = abs(Astro, Astro.url.pathname);
const ogImage = abs(Astro, image || SITE.defaultImage);
const robots = noindex || preview ? 'noindex, nofollow' : 'index, follow';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content={SITE.themeColor}>
<meta name="author" content={SITE.author}>

<meta property="og:type" content={type}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content={SITE.locale}>
{type === 'article' && published && <meta property="article:published_time" content={published} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<ThemeVars />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={site.fonts.googleUrl} rel="stylesheet">
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={abs(Astro, '/rss.xml')}>
{jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body data-theme="day">
{preview && (
  <div class="preview-bar">
    <span>👁 preview — how it looks on the blog · <b>not published yet</b></span>
    <button type="button" class="pv-close" onclick="window.close()">close</button>
  </div>
)}
<div id="progress"></div>

<!-- night-only ambience -->
{site.features.fireflies && <div class="nightfx" id="fireflies" aria-hidden="true"></div>}

<!-- rough marker filter -->
<svg width="0" height="0" style="position:absolute"><defs>
  <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="3" seed="7" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5" xChannelSelector="R" yChannelSelector="G"/></filter>
</defs></svg>

<header class="mast">
  <div class="wrap mast-inner">
    <a class="brand" href="/" style="text-decoration:none">{site.brand.name} {site.brand.mark}</a>
    <nav><ul>
      {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul></nav>
    {site.features.nightMode && <button class="theme-btn" id="themeBtn">☾ night</button>}
  </div>
</header>

<slot />

<footer>
  <a class="brand" href="/" style="text-decoration:none">{site.brand.name} {site.brand.mark}</a>
  <p>{site.brand.footerLine} · {site.brand.year}</p>
  {site.brand.credit && <p style="margin-top:8px;font-family:var(--grotesk);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)">Created by <span style="color:var(--pink)">{site.brand.credit}</span></p>}
</footer>

<script is:inline>
  const themeBtn=document.getElementById('themeBtn');
  themeBtn.onclick=()=>{
    const night=document.body.getAttribute('data-theme')==='night';
    document.body.setAttribute('data-theme',night?'day':'night');
    themeBtn.textContent=night?'☾ night':'☀ day';
  };
  const prog=document.getElementById('progress');
  window.addEventListener('scroll',()=>{const h=document.documentElement;
    prog.style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';});
  const rvEls=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:0,rootMargin:'0px 0px -8% 0px'});
    rvEls.forEach(el=>io.observe(el));
    const revealVisible=()=>rvEls.forEach(el=>{const r=el.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0)el.classList.add('in');});
    addEventListener('load',revealVisible);revealVisible();
  }else{rvEls.forEach(el=>el.classList.add('in'));}

  /* ── night ambience + interactivity: fireflies (scatter) + eye-follow ── */
  (function(){
    const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
    const box=document.getElementById('fireflies');
    const ff=[];
    if(box && !reduce){
      const N=innerWidth<680?10:18;
      for(let i=0;i<N;i++){
        const f=document.createElement('span');f.className='firefly';
        const s=(3+Math.random()*4).toFixed(1);
        f.style.left=(Math.random()*100)+'vw';
        f.style.top=(8+Math.random()*82)+'vh';
        f.style.width=s+'px';f.style.height=s+'px';
        f.style.setProperty('--dx',(Math.random()*120-60).toFixed(0)+'px');
        f.style.setProperty('--dy',(Math.random()*120-60).toFixed(0)+'px');
        f.style.setProperty('--dur',(12+Math.random()*12).toFixed(1)+'s');
        f.style.animationDelay=(-Math.random()*16).toFixed(1)+'s';
        const dot=document.createElement('i');
        dot.style.setProperty('--tw',(2+Math.random()*3).toFixed(1)+'s');
        dot.style.animationDelay=(-Math.random()*5).toFixed(1)+'s';
        f.appendChild(dot);box.appendChild(f);ff.push(f);
      }
    }
    const eyeSvg=document.querySelector('.eye-d');
    const eyeBall=eyeSvg&&eyeSvg.querySelector('.eye-ball');
    let mx=innerWidth/2,my=innerHeight/2,moved=false;
    const night=()=>document.body.getAttribute('data-theme')==='night';
    addEventListener('pointermove',e=>{if(e.pointerType&&e.pointerType!=='mouse')return;mx=e.clientX;my=e.clientY;moved=true;},{passive:true});
    function tick(){
      if(moved){
        moved=false;
        if(eyeBall){
          const r=eyeSvg.getBoundingClientRect();
          const cx=r.left+r.width/2, cy=r.top+r.height/2;
          const dx=mx-cx, dy=my-cy;
          if(Math.hypot(dx,dy)<200){
            const ex=Math.max(-1,Math.min(1,dx/130)), ey=Math.max(-1,Math.min(1,dy/130));
            eyeBall.setAttribute('transform','translate('+(ex*13).toFixed(1)+','+(ey*5).toFixed(1)+')');
          }else{
            eyeBall.setAttribute('transform','translate(0,0)');
          }
        }
        if(night() && !reduce){
          for(const f of ff){
            const dot=f.firstChild,r=f.getBoundingClientRect();
            const dx=(r.left+r.width/2)-mx,dy=(r.top+r.height/2)-my,d=Math.hypot(dx,dy);
            if(d<95){const p=(95-d)/95*42;dot.style.transform='translate('+(dx/(d||1)*p).toFixed(1)+'px,'+(dy/(d||1)*p).toFixed(1)+'px)';}
            else dot.style.transform='none';
          }
        }
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>

<!-- reader interactions: likes + comments -->
<script is:inline>
  (() => {
    const nodes = [...document.querySelectorAll('.ix')];
    if (!nodes.length) return;
    let liked;
    try { liked = new Set(JSON.parse(localStorage.getItem('liked') || '[]')); } catch { liked = new Set(); }
    const saveLiked = () => { try { localStorage.setItem('liked', JSON.stringify([...liked])); } catch {} };
    const fmt = (iso) => { try { return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); } catch { return ''; } };

    function markLiked(n, on) {
      const btn = n.querySelector('.ix-like');
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.querySelector('.ix-heart').textContent = on ? '♥' : '♡';
      btn.classList.toggle('on', on);
    }
    function commentEl(c) {
      const d = document.createElement('div'); d.className = 'ix-cmt';
      const meta = document.createElement('div'); meta.className = 'ix-cmt-meta';
      const nm = document.createElement('b'); nm.textContent = c.author; meta.appendChild(nm);
      const dt = document.createElement('span'); dt.className = 'ix-cmt-date'; dt.textContent = fmt(c.created_at); meta.appendChild(dt);
      const bd = document.createElement('div'); bd.className = 'ix-cmt-body'; bd.textContent = c.body;
      d.appendChild(meta); d.appendChild(bd); return d;
    }

    // batch-fetch counts
    const targets = nodes.map((n) => n.dataset.target);
    fetch('/api/counts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ targets }) })
      .then((r) => r.json()).then(({ counts }) => {
        nodes.forEach((n) => {
          const c = (counts && counts[n.dataset.target]) || { likes: 0, comments: 0 };
          n.querySelector('.ix-like-n').textContent = c.likes;
          const cn = n.querySelector('.ix-cmt-n'); if (cn) cn.textContent = c.comments;
          if (liked.has(n.dataset.target)) markLiked(n, true);
        });
      }).catch(() => {});

    nodes.forEach((n) => {
      const t = n.dataset.target;
      const likeBtn = n.querySelector('.ix-like');
      const likeN = n.querySelector('.ix-like-n');
      likeBtn.addEventListener('click', async () => {
        const on = !liked.has(t);
        if (on) liked.add(t); else liked.delete(t); saveLiked(); markLiked(n, on);
        likeN.textContent = Math.max(0, (parseInt(likeN.textContent || '0', 10) + (on ? 1 : -1)));
        try {
          const r = await fetch('/api/like', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ target: t, dir: on ? 1 : -1 }) });
          const { count } = await r.json(); if (typeof count === 'number') likeN.textContent = count;
        } catch {}
      });

      if (n.dataset.comments === '1') {
        const cmtBtn = n.querySelector('.ix-cmt-btn');
        const panel = n.querySelector('.ix-panel');
        const list = n.querySelector('.ix-list');
        const form = n.querySelector('.ix-form');
        let loaded = false;
        cmtBtn.addEventListener('click', async () => {
          panel.hidden = !panel.hidden;
          if (!panel.hidden && !loaded) {
            loaded = true;
            list.innerHTML = '<div class="ix-note">loading…</div>';
            try {
              const r = await fetch('/api/comments?target=' + encodeURIComponent(t));
              const { comments } = await r.json();
              if (!comments || !comments.length) list.innerHTML = '<div class="ix-note">no comments yet — be the first.</div>';
              else { list.innerHTML = ''; comments.forEach((c) => list.appendChild(commentEl(c))); }
            } catch { list.innerHTML = '<div class="ix-note">could not load comments</div>'; }
          }
        });
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const name = form.querySelector('.ix-name').value.trim();
          const body = form.querySelector('.ix-body').value.trim();
          const hp = form.querySelector('.ix-hp').value;
          if (!name || !body) return;
          const btn = form.querySelector('.ix-post'); btn.disabled = true;
          try {
            const r = await fetch('/api/comments', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ target: t, author: name, body, hp }) });
            const { comment } = await r.json();
            if (comment) {
              const note = list.querySelector('.ix-note'); if (note) note.remove();
              list.appendChild(commentEl(comment));
              form.querySelector('.ix-body').value = '';
              const cn = n.querySelector('.ix-cmt-n'); cn.textContent = (parseInt(cn.textContent || '0', 10) + 1);
            }
          } catch {} finally { btn.disabled = false; }
        });
      }
    });
  })();
</script>

<!-- image lightbox: click any gallery photo to view it full-size -->
<div id="lightbox" class="lightbox" aria-hidden="true">
  <button class="lb-close" type="button" aria-label="close">✕</button>
  <img class="lb-img" alt="" />
  <div class="lb-cap"></div>
</div>
<script is:inline>
  (() => {
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const img = lb.querySelector('.lb-img');
    const cap = lb.querySelector('.lb-cap');
    function open(src, caption) {
      img.src = src; cap.textContent = caption || ''; cap.style.display = caption ? '' : 'none';
      lb.classList.add('open'); document.body.style.overflow = 'hidden';
    }
    function close() { lb.classList.remove('open'); img.src = ''; document.body.style.overflow = ''; }
    document.addEventListener('click', (e) => {
      const z = e.target.closest('.zoomable');
      if (z && z.tagName === 'IMG') { open(z.currentSrc || z.src, z.dataset.caption || z.alt); return; }
      if (e.target === lb || e.target.closest('.lb-close')) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
</script>
</body>
</html>
