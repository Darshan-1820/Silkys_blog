---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.config.js';
import { abs } from '../lib/seo.js';

// ─────────────────────────────────────────────────────────────────────────
//  ABOUT — "Silky's desk". A warm top-down desk packed with her things.
//  Click an object → a handwritten note flips up with her favourites.
//
//  Object art: Microsoft Fluent Emoji (3D) — MIT licensed, free for
//  commercial use. Files in /public/desk/.
//
//  ⚑ EDIT HER REAL FAVOURITES in the `favs` block below (placeholders now).
// ─────────────────────────────────────────────────────────────────────────

const about = { nick: 'Silky', tag: 'writer · reader · overthinker-in-chief' };

const favs = {
  about: {
    title: "that's me",
    note: 'Shreya — but everyone says Silky',
    items: [
      'writer, reader, professional overthinker',
      'grew up in Patna hating books without pictures',
      'now up till 2am finishing book series',
      'here for the stories too loud to sleep on',
    ],
  },
  smokes: { title: 'the smokes', note: "don't tell mum",
    items: ['Marlboro Red — the classic', 'Marlboro Advance', 'Classic Milds — daytime', 'a stolen one always tastes better'] },
  drinks: { title: 'the drinks', note: 'editing fuel',
    items: ['whisky, neat', 'Old Monk & coke', 'black coffee at 2am', 'cheap red wine', 'chai — always'] },
  books: { title: 'the reading pile', note: 'the guilty, ever-growing stack',
    items: ['The Bell Jar — Sylvia Plath', 'Norwegian Wood — Murakami', 'Milk and Honey — Rupi Kaur', 'anything with a tragic ending'] },
  music: { title: 'on repeat', note: 'scored to heartbreak',
    items: ['TV Girl — everything', 'Cigarettes After Sex', 'Lana Del Rey', 'Arctic Monkeys — AM', 'old Bollywood at 3am'] },
  movies: { title: 'the movies', note: 'watched too many times',
    items: ['Eternal Sunshine of the Spotless Mind', 'Call Me By Your Name', 'anything Wong Kar-wai', '500 Days of Summer', 'Jab We Met — comfort watch'] },
  flowers: { title: 'the flowers', note: 'the ones that dry pretty',
    items: ['white tulips', "baby's breath", 'sunflowers — on good days', 'carnations', 'dried roses'] },
};

// Every object on the desk. `cat` = clickable (opens favourites). No `cat` = décor.
const objects = [
  { img: 'coffee.png',    x: 24, y: 3,  r: -5, w: 9,  alt: 'coffee' },
  { img: 'lipstick.png',  x: 34, y: 1,  r: 18, w: 5,  alt: 'lipstick' },
  { img: 'candle.png',    x: 46, y: 2,  r: 0,  w: 7,  alt: 'candle' },
  { img: 'camera.png',    x: 82, y: 5,  r: -8, w: 14, alt: 'camera' },
  { img: 'wine.png',      x: 66, y: 46, r: -4, w: 8,  alt: 'wine glass' },
  { img: 'pen.png',       x: 45, y: 47, r: -28, w: 15, alt: 'pen' },
  { img: 'notebook.png',  x: 37, y: 58, r: 4,  w: 18, alt: 'notebook' },
  { img: 'rose.png',      x: 85, y: 62, r: -12, w: 9, alt: 'rose' },
  { img: 'blossom.png',   x: 73, y: 72, r: 10, w: 9,  alt: 'blossom' },
  { img: 'headphone.png', x: 62, y: 63, r: 8,  w: 13, alt: 'headphones' },

  { img: 'cigarette.png', x: 32, y: 12, r: 9,  w: 12, cat: 'smokes',  lbl: 'smokes' },
  { img: 'clapper.png',   x: 41, y: 17, r: -6, w: 15, cat: 'movies',  lbl: 'movies' },
  { img: 'bouquet.png',   x: 57, y: 3,  r: 4,  w: 14, cat: 'flowers', lbl: 'flowers' },
  { img: 'tumbler.png',   x: 84, y: 40, r: 0,  w: 11, cat: 'drinks',  lbl: 'drinks' },
  { img: 'cassette.png',  x: 2,  y: 60, r: 6,  w: 16, cat: 'music',   lbl: 'on repeat' },
  { img: 'books.png',     x: 20, y: 64, r: -3, w: 15, cat: 'books',   lbl: 'books' },
];

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: `About ${about.nick}`, url: abs(Astro, '/about'),
  mainEntity: { '@type': 'Person', name: 'Shreya Silky', alternateName: 'Silky', jobTitle: 'Writer', url: abs(Astro, '/') },
}];
---
<Base
  title={`About — ${site.brand.name} ${site.brand.mark}`}
  description="Shreya (Silky) — writer, reader, overthinker-in-chief. Poke around her desk."
  jsonld={jsonld}
>
<main id="about" class="wrap">

  <header class="ab-hero">
    <span class="sticker">about</span>
    <h1 class="ab-name">Hi, I'm {about.nick}.</h1>
    <svg class="scribble" viewBox="0 0 340 16" preserveAspectRatio="none" style="max-width:300px"><path d="M4 11 q40 -9 80 -3 q50 7 96 -2 q56 -10 104 1 q30 6 52 -1"/></svg>
    <p class="ab-tag">{about.tag}</p>
    <p class="ab-hint">this is my desk. everything on it is a little piece of me — <b>tap the things</b> to snoop. ✦</p>
  </header>

  <!-- ── THE DESK ── -->
  <section class="desk" aria-label="Silky's desk — tap an object">

    <!-- polaroid (her photo) → about -->
    <button class="item pola-item" data-cat="about" style="--x:2;--y:8;--r:-6;--w:17" aria-label="about Silky">
      <span class="pola">
        <span class="tape" style="top:-10px;left:50%;margin-left:-40px;transform:rotate(-4deg)"></span>
        <img src="/silky.jpg" alt="Silky" width="680" height="850" />
        <span class="pola-cap">that's me ✎</span>
      </span>
    </button>

    {objects.map((o) => (
      o.cat ? (
        <button class="item obj-btn" data-cat={o.cat} style={`--x:${o.x};--y:${o.y};--r:${o.r};--w:${o.w}`} aria-label={`Silky's ${o.lbl}`}>
          <img src={`/desk/${o.img}`} alt="" />
          <figcaption class="lbl">{o.lbl}</figcaption>
        </button>
      ) : (
        <figure class="item deco-obj" style={`--x:${o.x};--y:${o.y};--r:${o.r};--w:${o.w}`}>
          <img src={`/desk/${o.img}`} alt="" />
        </figure>
      )
    ))}

  </section>

  <div class="ab-cta">
    <a class="read-cta" href="/#wall" style="display:inline-block;text-decoration:none">now read the diary →</a>
  </div>

  <!-- favourites data (hidden; cloned into the note on click) -->
  <div id="deskData" hidden>
    {Object.entries(favs).map(([cat, d]) => (
      <div class="dset" data-cat={cat}>
        <h3>{d.title}</h3>
        {d.note && <p class="dc-note">“{d.note}”</p>}
        <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
  </div>

  <!-- the note card that flips up -->
  <div id="deskCard" class="desk-card" aria-hidden="true">
    <div class="dc-inner" role="dialog" aria-modal="true">
      <span class="tape" style="top:-12px;left:40px;transform:rotate(-5deg)"></span>
      <span class="tape" style="top:-12px;right:40px;transform:rotate(6deg)"></span>
      <button class="dc-close" type="button" aria-label="close">✕</button>
      <div class="dc-body"></div>
    </div>
  </div>

</main>

<script is:inline>
  (() => {
    const card = document.getElementById('deskCard');
    if (!card) return;
    const body = card.querySelector('.dc-body');
    const data = {};
    document.querySelectorAll('#deskData .dset').forEach((d) => { data[d.dataset.cat] = d.innerHTML; });
    let lastFocus = null;
    function open(cat, trigger) {
      if (!data[cat]) return;
      lastFocus = trigger || null;
      body.innerHTML = data[cat];
      card.classList.add('open'); card.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; card.querySelector('.dc-close').focus();
    }
    function close() {
      card.classList.remove('open'); card.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; if (lastFocus) lastFocus.focus();
    }
    document.querySelectorAll('[data-cat]').forEach((b) => {
      if (b.classList.contains('dset')) return;
      b.addEventListener('click', () => open(b.dataset.cat, b));
    });
    card.addEventListener('click', (e) => { if (e.target === card || e.target.closest('.dc-close')) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && card.classList.contains('open')) close(); });
  })();
</script>

<style>
  #about { padding-bottom: 40px; }

  .ab-hero { padding: 44px 0 6px; }
  .ab-hero .sticker { font-size: 1rem; margin-bottom: 18px; }
  .ab-name { font-family: var(--marker); font-weight: 700; color: var(--pink);
    font-size: clamp(2.8rem, 8vw, 5.2rem); line-height: .9; margin: 12px 0 0; text-shadow: 2px 2px 0 var(--blue); }
  .ab-tag { font-family: var(--hand); font-size: clamp(1rem, 2.4vw, 1.3rem); color: var(--blue); margin-top: 12px; transform: rotate(-.8deg); }
  .ab-hint { font-family: var(--type); font-size: .92rem; color: var(--ink-soft); margin-top: 16px; }
  .ab-hint b { color: var(--pink); }

  /* ── wooden desk surface ── */
  .desk { position: relative; container-type: inline-size;
    width: 100%; max-width: 1120px; margin: 22px auto 10px; aspect-ratio: 1120 / 680;
    border-radius: 14px; overflow: hidden;
    background-color: #6f4626;
    background-image:
      radial-gradient(130% 100% at 80% 0%, rgba(255,214,150,.32), transparent 55%),
      linear-gradient(0deg, rgba(0,0,0,.30), transparent 34%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.03) 0 3px, rgba(0,0,0,.035) 3px 6px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.18) 0 2px, rgba(255,255,255,.02) 2px 4px, transparent 4px 168px),
      linear-gradient(100deg, #7c5233, #6b4425);
    box-shadow: inset 0 0 120px rgba(0,0,0,.3), 0 22px 55px rgba(0,0,0,.28);
    border: 1px solid rgba(0,0,0,.2); }
  [data-theme="night"] .desk {
    background-color: #38271b;
    background-image:
      radial-gradient(130% 100% at 80% 0%, rgba(150,160,230,.16), transparent 52%),
      linear-gradient(0deg, rgba(0,0,0,.42), transparent 34%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.02) 0 3px, rgba(0,0,0,.05) 3px 6px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.24) 0 2px, rgba(255,255,255,.015) 2px 4px, transparent 4px 168px),
      linear-gradient(100deg, #43301f, #34241792); }

  .item { position: absolute; left: calc(var(--x) * 1%); top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1cqw); transform: rotate(calc(var(--r) * 1deg));
    display: flex; flex-direction: column; align-items: center; gap: .5cqw; margin: 0; padding: 0; }
  .item img { width: 100%; height: auto; display: block;
    filter: drop-shadow(3px 7px 7px rgba(0,0,0,.5)); }
  .lbl { font-family: var(--hand); font-size: 1.5cqw; color: #fff5e6; text-align: center; line-height: 1;
    background: rgba(30,18,10,.55); padding: .3cqw .7cqw; border-radius: 3px; }

  button.obj-btn { background: none; border: 0; cursor: pointer; transition: transform .18s var(--ease); z-index: 2; }
  button.obj-btn:hover, button.obj-btn:focus-visible { transform: rotate(calc(var(--r) * 1deg)) translateY(-7px) scale(1.08); outline: none; z-index: 9; }
  button.obj-btn:hover .lbl, button.obj-btn:focus-visible .lbl { background: var(--pink); }
  button.obj-btn::after { content: ""; position: absolute; inset: -10% -12% 4%; border-radius: 14px;
    background: radial-gradient(circle, rgba(255,220,150,.5), transparent 68%); opacity: 0; transition: opacity .2s; z-index: -1; }
  button.obj-btn:hover::after, button.obj-btn:focus-visible::after { opacity: 1; }

  /* polaroid */
  .pola-item { z-index: 3; cursor: pointer; background: none; border: 0; transition: transform .18s var(--ease); }
  .pola-item:hover, .pola-item:focus-visible { transform: rotate(calc(var(--r) * 1deg)) translateY(-7px) scale(1.05); outline: none; z-index: 9; }
  .pola { display: block; background: #fbf8ee; padding: 6% 6% 12%; position: relative;
    box-shadow: 5px 12px 26px rgba(0,0,0,.5); width: 100%; }
  .pola img { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: 34% 24%; filter: none; }
  .pola-cap { display: block; font-family: var(--marker); font-weight: 700; font-size: 2.3cqw; color: #181622; text-align: center; margin-top: 4%; }

  /* ── note card ── */
  .desk-card { position: fixed; inset: 0; z-index: 200; display: none; align-items: center; justify-content: center;
    background: rgba(18,16,26,.55); backdrop-filter: blur(3px); padding: 24px; }
  .desk-card.open { display: flex; }
  .dc-inner { position: relative; background: var(--card); width: min(420px, 92vw); padding: 40px 34px 34px;
    box-shadow: 0 24px 70px rgba(0,0,0,.5); transform: rotate(-1.2deg);
    background-image: repeating-linear-gradient(var(--card) 0 30px, color-mix(in srgb, var(--blue) 16%, transparent) 30px 31px);
    animation: pop .28s var(--ease); }
  @keyframes pop { from { transform: rotate(-1.2deg) scale(.85); opacity: 0; } to { transform: rotate(-1.2deg) scale(1); opacity: 1; } }
  .dc-close { position: absolute; top: 8px; right: 10px; background: var(--ink); color: var(--paper); border: 0;
    width: 30px; height: 30px; cursor: pointer; font-size: .9rem; line-height: 1; box-shadow: 2px 2px 0 rgba(0,0,0,.25); }
  .dc-close:hover { background: var(--pink); }
  .dc-body :global(h3) { font-family: var(--marker); font-weight: 700; font-size: 2.4rem; color: var(--pink);
    text-shadow: 1.5px 1.5px 0 var(--blue); line-height: .95; margin-bottom: 4px; }
  .dc-body :global(.dc-note) { font-family: var(--hand); font-size: 1rem; color: var(--blue); margin-bottom: 16px; }
  .dc-body :global(ul) { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .dc-body :global(li) { font-family: var(--type); font-size: 1rem; color: var(--ink); line-height: 1.4; padding-left: 26px; position: relative; }
  .dc-body :global(li)::before { content: "✦"; position: absolute; left: 0; top: 1px; color: var(--pink); }

  .ab-cta { text-align: center; padding: 26px 0 20px; }

  /* ── mobile: desk reflows into a tidy stack ── */
  @media (max-width: 760px) {
    .desk { position: static; aspect-ratio: auto; container-type: normal; border-radius: 14px;
      display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end;
      gap: 26px 20px; padding: 32px 18px; }
    .item { position: static; width: auto; }
    .item img { width: 88px; }
    .pola-item .pola { width: 200px; }
    .pola-item .pola img { width: 100%; }
    .lbl { font-size: .85rem; padding: 2px 7px; }
    .pola-cap { font-size: 1.4rem; }
  }
</style>
</Base>
