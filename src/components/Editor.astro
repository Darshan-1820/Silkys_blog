---
// The studio — Silky's writing space. `post` is a D1 row when editing, else null.
const { post = null } = Astro.props;
const SECTIONS = [
  ['blog', 'blog'],
  ['diary', 'digital diary'],
  ['short_story', 'short story'],
  ['incident', 'incident'],
  ['reflection', 'reflection'],
];
const DOODLES = ['star', 'moon', 'eye', 'heart', 'sun'];
const p = post || {};
const bodyHtml = p.body_html || '';
const status = p.status || 'draft';
---
<div
  id="editor-root"
  class="studio"
  data-post-id={post ? String(post.id) : ''}
  data-status={status}
  data-slug={p.slug || ''}
>
  <!-- top bar -->
  <div class="studio-top">
    <a class="btn ghost" href="/admin">← the desk</a>
    <div class="top-right">
      <span id="state-chip" class="chip">draft</span>
      <span id="save-status" class="save-status"></span>
      <button class="btn ghost only-mobile" type="button" id="btn-details">✎ details</button>
      <button class="btn ghost" type="button" id="btn-preview">preview ↗</button>
      <button class="btn" type="button" id="btn-publish">publish ✷</button>
    </div>
  </div>

  <div class="studio-grid">
    <!-- writing area -->
    <div class="studio-main">
      <!-- margin doodles (decor only) -->
      <svg class="m-doodle" style="top:70px;left:-38px;width:60px;transform:rotate(-14deg)" viewBox="0 0 60 60" fill="var(--pink)" aria-hidden="true"><path d="M30 2 L36 24 L58 30 L36 36 L30 58 L24 36 L2 30 L24 24 Z"/></svg>
      <svg class="m-doodle" style="bottom:120px;right:-30px;width:52px;transform:rotate(10deg)" viewBox="0 0 100 100" fill="var(--blue)" aria-hidden="true"><path d="M64 12 a36 36 0 1 0 4 70 a28 28 0 1 1 -4-70 z"/></svg>
      <svg class="m-doodle" style="top:280px;right:-26px;width:34px;transform:rotate(-6deg)" viewBox="0 0 100 100" fill="var(--pink)" aria-hidden="true"><path d="M50 84 C6 54 16 14 50 36 C84 14 94 54 50 84 Z"/></svg>

      <input id="f-title" class="title-in" type="text" placeholder="give it a title…" value={p.title || ''} autocomplete="off" />

      <div class="toolbar" id="toolbar">
        <button type="button" data-cmd="h2" title="heading">H2</button>
        <button type="button" data-cmd="h3" title="small heading">H3</button>
        <span class="sep"></span>
        <button type="button" data-cmd="bullet" title="bullet list">• list</button>
        <button type="button" data-cmd="ordered" title="numbered list">1. list</button>
        <button type="button" data-cmd="quote" title="quote">❝</button>
        <span class="sep"></span>
        <button type="button" data-cmd="image" title="add a photo" class="photo-btn">＋ photo</button>
        <span class="sep"></span>
        <button type="button" data-cmd="undo" title="undo">↶</button>
        <button type="button" data-cmd="redo" title="redo">↷</button>
      </div>

      <div id="editor-mount" class="editor-mount"></div>
      <template id="body-initial" set:html={bodyHtml}></template>

      <p class="hint-line">tip · select any words to make them <b>bold</b>, <i>italic</i>, or a link. paste straight from Google Docs, or drag a photo onto the page.</p>
    </div>

    <!-- details sticky note -->
    <aside class="studio-side" id="studio-side">
      <div class="note">
        <span class="note-tape"></span>
        <div class="note-h">the details</div>

        <label class="nf"><span>which section?</span>
          <select id="f-section" class="in">
            {SECTIONS.map(([v, l]) => <option value={v} selected={p.section === v}>{l}</option>)}
          </select>
        </label>

        <label class="nf"><span>its little doodle</span>
          <select id="f-doodle" class="in">
            {DOODLES.map((d) => <option value={d} selected={(p.doodle || 'star') === d}>{d}</option>)}
          </select>
        </label>

        <div class="nf"><span>cover photo</span>
          <div class="cover-box" id="cover-box" data-url={p.cover_url || ''}>
            <img id="cover-preview" src={p.cover_url || ''} alt="" style={p.cover_url ? '' : 'display:none'} />
            <button class="btn ghost small" type="button" id="btn-cover">choose a photo…</button>
            <button class="btn ghost small" type="button" id="btn-cover-remove" style={p.cover_url ? '' : 'display:none'}>remove</button>
            <input id="cover-input" type="file" accept="image/*" hidden />
          </div>
        </div>

        <label class="nf"><span>the teaser (shown on the wall)</span>
          <textarea id="f-excerpt" class="in" rows="3" placeholder="a line or two to draw people in…">{p.excerpt || ''}</textarea>
        </label>

        <label class="nf"><span>song it's scored to</span>
          <input id="f-song" class="in" type="text" value={p.song || ''} placeholder="artist — track (optional)" />
        </label>

        <label class="nf"><span>▸ song link — so the radio can play it</span>
          <input id="f-song-url" class="in" type="url" value={p.song_url || ''} placeholder="paste a Spotify or YouTube link" />
        </label>

        <label class="check"><input id="f-featured" type="checkbox" checked={!!p.featured} /> <span>feature on the homepage ✷</span></label>

        <div class="note-foot">
          <a id="link-view" class="note-link" href="#" target="_blank" style="display:none">view it live ↗</a>
          <button id="btn-unpublish" class="note-link" type="button" style="display:none">move back to draft</button>
          {post && <button id="btn-delete" class="note-link danger" type="button">delete this piece</button>}
        </div>
      </div>
    </aside>
  </div>

  <!-- selection bubble -->
  <div id="bubble" class="bubble">
    <button type="button" data-cmd="bold" title="bold"><b>B</b></button>
    <button type="button" data-cmd="italic" title="italic"><i>I</i></button>
    <button type="button" data-cmd="h2" title="heading">H2</button>
    <button type="button" data-cmd="quote" title="quote">❝</button>
    <button type="button" data-cmd="link" title="link">🔗</button>
  </div>

  <!-- image controls (appear when a photo is clicked) -->
  <div id="img-bar" class="bubble img-bar">
    <button type="button" data-size="small" title="small">small</button>
    <button type="button" data-size="medium" title="medium">medium</button>
    <button type="button" data-size="full" title="full width">full</button>
    <span class="ibsep"></span>
    <button type="button" data-img="alt" title="describe the photo (accessibility + SEO)">alt</button>
    <button type="button" data-img="remove" class="rm" title="remove photo">✕ remove</button>
  </div>

  <!-- toast -->
  <div id="toast" class="toast"></div>
</div>

<style is:global>
  body:has(.studio){background-image:linear-gradient(rgba(43,40,120,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(43,40,120,.05) 1px,transparent 1px);background-size:26px 26px}
  .studio{max-width:1120px;margin:0 auto;padding:22px 22px 90px}
  .studio-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;position:sticky;top:0;z-index:20;
    background:linear-gradient(var(--paper),var(--paper) 70%,transparent);padding:10px 0}
  .top-right{display:flex;align-items:center;gap:12px}
  .chip{font-family:var(--sticker);font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:#fff;background:#8a8698;padding:3px 11px 4px;transform:rotate(-2deg)}
  .chip.live{background:var(--blue)}
  .save-status{font-family:var(--type);font-size:.82rem;color:var(--ink-soft);min-width:78px}
  .save-status.ok{color:var(--blue-deep)} .save-status.err,.save-status.hint{color:var(--pink-deep)}

  .studio-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:34px;align-items:start}
  .studio-main{position:relative}
  .m-doodle{position:absolute;opacity:.5;pointer-events:none;z-index:0}
  @media(max-width:900px){.m-doodle{display:none}}

  .title-in{width:100%;font-family:var(--marker);font-size:2.7rem;line-height:1.05;color:var(--ink);
    background:transparent;border:none;border-bottom:2.5px dashed rgba(24,22,34,.28);padding:4px 2px 10px;outline:none;position:relative;z-index:1}
  .title-in::placeholder{color:rgba(24,22,34,.32)}
  .title-in:focus{border-color:var(--pink)}

  .toolbar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin:16px 0 0;position:relative;z-index:1}
  .toolbar button{font-family:var(--type);cursor:pointer;background:var(--card);border:2px solid var(--ink);
    padding:5px 11px;font-size:.86rem;color:var(--ink);box-shadow:2px 2px 0 rgba(0,0,0,.15);line-height:1;transition:transform .1s,box-shadow .1s}
  .toolbar button:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0 rgba(0,0,0,.18)}
  .toolbar button:active{transform:translate(1px,1px);box-shadow:1px 1px 0 rgba(0,0,0,.15)}
  .toolbar button.on{background:var(--blue);color:#fff}
  .toolbar .photo-btn{background:var(--pink);color:#fff;border-color:var(--ink)}
  .toolbar .sep{width:2px;height:20px;background:rgba(24,22,34,.14);margin:0 3px}

  .editor-mount{position:relative;z-index:1;margin-top:14px;min-height:52vh;padding:26px 4px 40px}
  .ProseMirror{outline:none;font-family:var(--type);font-size:1.08rem;line-height:1.85;color:var(--ink)}
  .ProseMirror:focus{outline:none}
  .ProseMirror > *+*{margin-top:.9em}
  .ProseMirror h2{font-family:var(--marker);font-size:2rem;line-height:1.1;color:var(--blue-deep)}
  .ProseMirror h3{font-family:var(--marker);font-size:1.5rem;line-height:1.15}
  .ProseMirror ul,.ProseMirror ol{padding-left:1.5em}
  .ProseMirror blockquote{border-left:3px solid var(--pink);padding-left:16px;color:var(--ink-soft);font-style:italic}
  .ProseMirror img{max-width:100%;height:auto;max-height:70vh;object-fit:contain;display:block;margin:10px auto;
    border:5px solid var(--card);box-shadow:4px 7px 18px rgba(0,0,0,.2);cursor:pointer}
  .ProseMirror img.img-small{max-width:240px} .ProseMirror img.img-medium{max-width:62%} .ProseMirror img.img-full{max-width:100%}
  .ProseMirror img.ProseMirror-selectednode{outline:3px solid var(--pink);outline-offset:3px}
  .ProseMirror a{color:var(--blue);text-decoration:underline}
  .ProseMirror p.is-editor-empty:first-child::before{content:attr(data-placeholder);float:left;color:rgba(24,22,34,.38);pointer-events:none;height:0;font-style:italic}
  .hint-line{font-family:var(--type);font-size:.82rem;color:var(--ink-soft);margin-top:22px;border-top:1.5px dashed rgba(24,22,34,.16);padding-top:14px;position:relative;z-index:1}

  /* sticky note */
  .studio-side{position:sticky;top:74px}
  .note{position:relative;background:#F6EFC7;border:2px solid rgba(24,22,34,.5);padding:26px 20px 20px;
    box-shadow:5px 8px 0 rgba(34,34,201,.14);transform:rotate(-.8deg)}
  [data-theme="night"] .note{background:#3a3730}
  .note-tape{position:absolute;top:-13px;left:50%;transform:translateX(-50%) rotate(-3deg);width:92px;height:24px;background:var(--tape);box-shadow:0 1px 4px rgba(0,0,0,.14)}
  .note-h{font-family:var(--marker);font-size:1.5rem;color:var(--ink);margin-bottom:8px}
  .nf{display:block;margin-top:15px}
  .nf > span{display:block;font-family:var(--hand);font-size:.76rem;color:var(--blue);margin-bottom:5px}
  .note .in{width:100%;font-family:var(--type);font-size:.92rem;padding:8px 10px;background:var(--card);border:2px solid var(--ink);color:var(--ink);outline:none}
  .note .in:focus{border-color:var(--pink)}
  .note textarea.in{resize:vertical}
  .cover-box{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
  #cover-preview{width:100%;max-height:150px;object-fit:cover;border:4px solid var(--card);box-shadow:2px 4px 10px rgba(0,0,0,.16);margin-bottom:4px}
  .btn.small{padding:6px 11px;font-size:.76rem;box-shadow:2px 2px 0 rgba(0,0,0,.2)}
  .note .check{display:flex;align-items:center;gap:9px;font-family:var(--type);font-size:.88rem;cursor:pointer;margin-top:18px}
  .note .check input{width:18px;height:18px;accent-color:var(--pink);flex:none}
  .note-foot{margin-top:20px;border-top:1.5px dashed rgba(24,22,34,.25);padding-top:12px;display:flex;flex-direction:column;gap:8px;align-items:flex-start}
  .note-link{font-family:var(--type);font-size:.84rem;color:var(--blue);background:none;border:none;cursor:pointer;padding:0;text-align:left;border-bottom:1.5px solid transparent}
  .note-link:hover{border-color:currentColor}
  .note-link.danger{color:var(--pink-deep)}

  .only-mobile{display:none}
  @media(max-width:820px){
    .studio-grid{grid-template-columns:1fr}
    .studio-side{position:static;margin-top:24px;display:none}
    .studio-side.open{display:block}
    .only-mobile{display:inline-block}
  }

  /* selection bubble */
  .bubble{position:fixed;z-index:60;display:none;gap:2px;background:var(--ink);padding:4px;border-radius:6px;
    box-shadow:0 6px 20px rgba(0,0,0,.3);transform:translate(-50%,-118%)}
  .bubble.show{display:flex}
  .bubble button{font-family:var(--type);cursor:pointer;background:transparent;border:none;color:#fff;padding:5px 9px;border-radius:4px;font-size:.9rem;line-height:1}
  .bubble button:hover{background:rgba(255,255,255,.16)}
  .bubble button.on{background:var(--pink)}
  .img-bar button{font-size:.78rem}
  .img-bar .rm{color:#ff9db3}
  .img-bar.below{transform:translate(-50%,10px)}
  .ibsep{width:1px;background:rgba(255,255,255,.25);margin:0 4px}

  /* toast */
  .toast{position:fixed;left:50%;bottom:34px;transform:translateX(-50%) translateY(20px);z-index:70;
    background:var(--blue);color:#fff;font-family:var(--sticker);letter-spacing:.04em;padding:11px 22px;
    box-shadow:3px 4px 0 rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Image from '@tiptap/extension-image';
  import Placeholder from '@tiptap/extension-placeholder';
  import { compressImage } from '../lib/img.js';

  // Image + a "size" choice (small / medium / full) stored as data-size + class.
  const SizedImage = Image.extend({
    addAttributes() {
      return {
        ...this.parent?.(),
        size: {
          default: 'full',
          parseHTML: (el) => el.getAttribute('data-size') || 'full',
          renderHTML: (attrs) => ({ 'data-size': attrs.size, class: `img-${attrs.size}` }),
        },
      };
    },
  });

  const root = document.getElementById('editor-root');
  const mount = document.getElementById('editor-mount');
  const initial = document.getElementById('body-initial').innerHTML;

  // --- state ---
  let postId = root.dataset.postId || '';
  let status = root.dataset.status || 'draft';
  let slug = root.dataset.slug || '';
  let saving = false;
  let saveTimer = null;
  let lastSnap = '';

  const $ = (id) => document.getElementById(id);
  const statusEl = $('save-status');
  function setStatus(msg, cls) { statusEl.textContent = msg; statusEl.className = 'save-status' + (cls ? ' ' + cls : ''); }

  function toast(msg) {
    const t = $('toast'); t.textContent = msg; t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  async function uploadImage(file) {
    file = await compressImage(file);
    const fd = new FormData(); fd.append('file', file);
    const r = await fetch('/api/upload', { method: 'POST', body: fd });
    if (!r.ok) throw new Error('upload failed');
    return (await r.json()).url;
  }

  // --- the editor ---
  let editor;
  editor = new Editor({
    element: mount,
    extensions: [
      StarterKit,
      SizedImage,
      Placeholder.configure({ placeholder: 'start writing… this page is yours.' }),
    ],
    content: initial || '',
    editorProps: {
      handlePaste(view, event) {
        const items = event.clipboardData && event.clipboardData.items;
        if (!items) return false;
        for (const it of items) {
          if (it.type.startsWith('image/')) {
            const file = it.getAsFile();
            if (file) uploadImage(file).then((url) => editor.chain().focus().setImage({ src: url }).run()).catch(() => toast('image failed'));
            return true;
          }
        }
        return false;
      },
      handleDrop(view, event) {
        const files = event.dataTransfer && event.dataTransfer.files;
        if (files && files.length && files[0].type.startsWith('image/')) {
          event.preventDefault();
          uploadImage(files[0]).then((url) => editor.chain().focus().setImage({ src: url }).run()).catch(() => toast('image failed'));
          return true;
        }
        return false;
      },
    },
    onUpdate: () => scheduleSave(),
    onSelectionUpdate: () => { refreshToolbar(); updateBubble(); updateImgBar(); },
    onTransaction: () => refreshToolbar(),
    onBlur: () => setTimeout(() => { $('bubble').classList.remove('show'); $('img-bar').classList.remove('show'); }, 160),
  });

  // --- commands (shared by toolbar + bubble) ---
  const imgInput = document.createElement('input');
  imgInput.type = 'file'; imgInput.accept = 'image/*'; imgInput.hidden = true;
  document.body.appendChild(imgInput);
  imgInput.addEventListener('change', async () => {
    if (imgInput.files && imgInput.files[0]) {
      try { const url = await uploadImage(imgInput.files[0]); editor.chain().focus().setImage({ src: url }).run(); }
      catch { toast('image failed'); }
      imgInput.value = '';
    }
  });

  const CMDS = {
    bold: () => editor.chain().focus().toggleBold().run(),
    italic: () => editor.chain().focus().toggleItalic().run(),
    h2: () => editor.chain().focus().toggleHeading({ level: 2 }).run(),
    h3: () => editor.chain().focus().toggleHeading({ level: 3 }).run(),
    bullet: () => editor.chain().focus().toggleBulletList().run(),
    ordered: () => editor.chain().focus().toggleOrderedList().run(),
    quote: () => editor.chain().focus().toggleBlockquote().run(),
    undo: () => editor.chain().focus().undo().run(),
    redo: () => editor.chain().focus().redo().run(),
    image: () => imgInput.click(),
    link: () => {
      const prev = editor.getAttributes('link').href || '';
      const url = window.prompt('link to…', prev);
      if (url === null) return;
      if (url === '') editor.chain().focus().extendMarkRange('link').unsetLink().run();
      else editor.chain().focus().extendMarkRange('link').setLink({ href: url }).run();
    },
  };
  function wireCmds(container) {
    container.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-cmd]');
      if (btn && CMDS[btn.dataset.cmd]) CMDS[btn.dataset.cmd]();
    });
  }
  wireCmds($('toolbar'));
  const bubble = $('bubble');
  bubble.addEventListener('mousedown', (e) => e.preventDefault()); // keep selection on click
  wireCmds(bubble);

  function refreshToolbar() {
    if (!editor) return;
    const s = {
      h2: editor.isActive('heading', { level: 2 }), h3: editor.isActive('heading', { level: 3 }),
      bullet: editor.isActive('bulletList'), ordered: editor.isActive('orderedList'),
      quote: editor.isActive('blockquote'),
      bold: editor.isActive('bold'), italic: editor.isActive('italic'), link: editor.isActive('link'),
    };
    document.querySelectorAll('button[data-cmd]').forEach((b) => b.classList.toggle('on', !!s[b.dataset.cmd]));
  }

  function updateBubble() {
    if (!editor) return;
    const { from, to, empty } = editor.state.selection;
    if (empty || !editor.isFocused || editor.isActive('image')) { bubble.classList.remove('show'); return; }
    const a = editor.view.coordsAtPos(from);
    const b = editor.view.coordsAtPos(to);
    bubble.style.top = Math.min(a.top, b.top) + 'px';
    bubble.style.left = (a.left + b.left) / 2 + 'px';
    bubble.classList.add('show');
  }

  // image controls: appear when a photo is clicked (selected as a node)
  const imgBar = $('img-bar');
  imgBar.addEventListener('mousedown', (e) => e.preventDefault());
  imgBar.querySelectorAll('[data-size]').forEach((b) => b.addEventListener('click', () => {
    editor.chain().focus().updateAttributes('image', { size: b.dataset.size }).run();
    updateImgBar();
  }));
  imgBar.querySelector('[data-img="alt"]').addEventListener('click', () => {
    const cur = editor.getAttributes('image').alt || '';
    const alt = window.prompt('describe this photo (for screen readers & search):', cur);
    if (alt !== null) editor.chain().focus().updateAttributes('image', { alt }).run();
  });
  imgBar.querySelector('[data-img="remove"]').addEventListener('click', () => {
    editor.chain().focus().deleteSelection().run();
    imgBar.classList.remove('show');
  });
  function updateImgBar() {
    if (!editor) return;
    if (!editor.isActive('image')) { imgBar.classList.remove('show'); return; }
    const dom = editor.view.nodeDOM(editor.state.selection.from);
    const el = dom && dom.nodeType === 1 ? dom : dom && dom.parentElement;
    if (!el || !el.getBoundingClientRect) { imgBar.classList.remove('show'); return; }
    const r = el.getBoundingClientRect();
    // if the photo is near the top, drop the bar BELOW it so it stays on screen
    if (r.top < 70) { imgBar.classList.add('below'); imgBar.style.top = r.bottom + 'px'; }
    else { imgBar.classList.remove('below'); imgBar.style.top = r.top + 'px'; }
    imgBar.style.left = Math.max(70, Math.min(window.innerWidth - 70, r.left + r.width / 2)) + 'px';
    imgBar.classList.add('show');
  }
  window.addEventListener('scroll', () => {
    if (bubble.classList.contains('show')) updateBubble();
    if (imgBar.classList.contains('show')) updateImgBar();
  }, true);

  // --- cover photo ---
  const coverBox = $('cover-box'), coverInput = $('cover-input'), coverPreview = $('cover-preview'), coverRemove = $('btn-cover-remove');
  $('btn-cover').addEventListener('click', () => coverInput.click());
  coverInput.addEventListener('change', async () => {
    if (!coverInput.files || !coverInput.files[0]) return;
    try {
      const url = await uploadImage(coverInput.files[0]);
      coverBox.dataset.url = url; coverPreview.src = url; coverPreview.style.display = 'block'; coverRemove.style.display = '';
      scheduleSave();
    } catch { toast('cover failed'); }
    coverInput.value = '';
  });
  coverRemove.addEventListener('click', () => {
    coverBox.dataset.url = ''; coverPreview.src = ''; coverPreview.style.display = 'none'; coverRemove.style.display = 'none';
    scheduleSave();
  });

  // --- collect + autosave ---
  function collect() {
    return {
      title: $('f-title').value.trim(),
      section: $('f-section').value,
      doodle: $('f-doodle').value,
      song: $('f-song').value,
      song_url: $('f-song-url').value.trim(),
      excerpt: $('f-excerpt').value,
      featured: $('f-featured').checked,
      cover_url: coverBox.dataset.url || null,
      body_html: editor.getHTML(),
    };
  }
  function snapshot() { return JSON.stringify(collect()); }

  async function doSave(targetStatus) {
    if (saving) return false;
    const data = collect();
    if (!data.title) { setStatus('add a title to save', 'hint'); return false; }
    const useStatus = targetStatus || status;
    saving = true; setStatus('saving…');
    try {
      const url = postId ? `/api/posts/${postId}` : '/api/posts';
      const r = await fetch(url, { method: postId ? 'PUT' : 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...data, status: useStatus }) });
      if (!r.ok) { setStatus("couldn't save", 'err'); return false; }
      const res = await r.json();
      if (!postId) { postId = String(res.id); history.replaceState({}, '', `/admin/edit/${postId}`); }
      slug = res.slug || slug;
      status = useStatus;
      lastSnap = JSON.stringify(data);
      reflectStatus();
      setStatus('saved ✓', 'ok');
      return true;
    } catch {
      setStatus("couldn't save", 'err'); return false;
    } finally { saving = false; }
  }

  function scheduleSave() {
    setStatus('unsaved…');
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => { if (snapshot() !== lastSnap) doSave(); }, 1200);
  }
  // autosave on any field change
  ['f-title', 'f-section', 'f-doodle', 'f-song', 'f-song-url', 'f-excerpt', 'f-featured'].forEach((id) => {
    $(id).addEventListener('input', scheduleSave);
    $(id).addEventListener('change', scheduleSave);
  });

  // --- publish / status ---
  const chip = $('state-chip'), pubBtn = $('btn-publish'), viewLink = $('link-view'), unpub = $('btn-unpublish');
  function reflectStatus() {
    const live = status === 'published';
    chip.textContent = live ? 'live' : 'draft';
    chip.classList.toggle('live', live);
    pubBtn.textContent = live ? 'view it ↗' : 'publish ✷';
    viewLink.style.display = live ? '' : 'none';
    unpub.style.display = live ? '' : 'none';
    if (live && slug) { viewLink.href = `/blog/${slug}`; }
  }
  pubBtn.addEventListener('click', async () => {
    if (status === 'published') { if (slug) window.open(`/blog/${slug}`, '_blank'); return; }
    const ok = await doSave('published');
    if (ok) toast('published ✷');
  });
  unpub.addEventListener('click', async () => {
    const ok = await doSave('draft');
    if (ok) toast('moved to draft');
  });

  // preview: save (keeping current status), then open the real blog page in preview mode
  $('btn-preview').addEventListener('click', async () => {
    const ok = await doSave();
    if (ok && slug) window.open(`/blog/${slug}?preview`, '_blank');
  });

  // --- delete ---
  const del = $('btn-delete');
  if (del) del.addEventListener('click', async () => {
    if (!window.confirm('delete this piece for good?')) return;
    const r = await fetch(`/api/posts/${postId}`, { method: 'DELETE' });
    if (r.ok) window.location.href = '/admin'; else toast('delete failed');
  });

  // --- details toggle (mobile) ---
  $('btn-details').addEventListener('click', () => $('studio-side').classList.toggle('open'));

  // --- don't lose work ---
  window.addEventListener('beforeunload', (e) => {
    if (snapshot() !== lastSnap && $('f-title').value.trim()) { e.preventDefault(); e.returnValue = ''; }
  });

  // init
  lastSnap = JSON.stringify(collect());
  reflectStatus();
  refreshToolbar();
</script>
