---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.config.js';
import { abs } from '../lib/seo.js';

// ─────────────────────────────────────────────────────────────────────────
//  ABOUT — "Silky's diary wall". Built entirely from the site's own collage
//  language (paper, tape, polaroids, marker doodles) so it feels native, not
//  bolted-on. Tap a favourite → a handwritten note flips up.
//
//  ⚑ EDIT HER REAL WORDS: `diary`, `now`, and `favs` below (placeholders now).
// ─────────────────────────────────────────────────────────────────────────

const about = { nick: 'Silky', tag: 'writer · reader · overthinker-in-chief' };

const diary = [
  "Hey. I'm Shreya — but everyone just calls me Silky.",
  "I'm a writer, a compulsive reader, and a professional overthinker (it's on the business card, right under “dramatic pauses”). I grew up in Patna finding books boring if they didn't have pictures — and somehow became the kind of person who stays up till 2am to finish a series she swore she'd shut at midnight.",
  "Somewhere along the way I started writing my own. Fiction, mostly. This little corner is where the leftover words end up — the stories, the incidents, the thoughts that were too loud to sleep on.",
  "I don't think the good stuff is built from résumés and job titles. It's curiosity, consistency, and the courage to keep showing up. So — here I am. Showing up. Again.",
];

const now = [
  { k: 'reading', v: 'anything with a body count and a heartbreak' },
  { k: 'writing', v: 'a story I keep almost finishing' },
  { k: 'drinking', v: 'coffee, cold again' },
  { k: 'avoiding', v: 'the draft that’s due' },
];

const favs = {
  smokes: { title: 'the smokes', note: "don't tell mum",
    items: ['Marlboro Red — the classic', 'Marlboro Advance', 'Classic Milds — daytime', 'a stolen one always tastes better'] },
  drinks: { title: 'the drinks', note: 'editing fuel',
    items: ['whisky, neat', 'Old Monk & coke', 'black coffee at 2am', 'cheap red wine', 'chai — always'] },
  books: { title: 'the reading pile', note: 'the guilty, ever-growing stack',
    items: ['The Bell Jar — Sylvia Plath', 'Norwegian Wood — Murakami', 'Milk and Honey — Rupi Kaur', 'anything with a tragic ending'] },
  music: { title: 'on repeat', note: 'scored to heartbreak',
    items: ['TV Girl — everything', 'Cigarettes After Sex', 'Lana Del Rey', 'Arctic Monkeys — AM', 'old Bollywood at 3am'] },
  movies: { title: 'the movies', note: 'watched too many times',
    items: ['Eternal Sunshine of the Spotless Mind', 'Call Me By Your Name', 'anything Wong Kar-wai', '500 Days of Summer', 'Jab We Met — comfort watch'] },
  flowers: { title: 'the flowers', note: 'the ones that dry pretty',
    items: ['white tulips', "baby's breath", 'sunflowers — on good days', 'carnations', 'dried roses'] },
};

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'AboutPage',
  name: `About ${about.nick}`, url: abs(Astro, '/about'),
  mainEntity: { '@type': 'Person', name: 'Shreya Silky', alternateName: 'Silky', jobTitle: 'Writer', url: abs(Astro, '/') },
}];
---
<Base
  title={`About — ${site.brand.name} ${site.brand.mark}`}
  description="Shreya (Silky) — writer, reader, overthinker-in-chief. The story behind the late-night scribbles."
  jsonld={jsonld}
>
<main id="about" class="wrap">

  <!-- intro -->
  <header class="ab-hero">
    <span class="sticker">about</span>
    <svg class="doodle ab-hide" style="top:6px;right:8px;width:64px;height:64px;transform:rotate(12deg)" viewBox="0 0 60 60" fill="var(--pink)"><path d="M30 2 L36 24 L58 30 L36 36 L30 58 L24 36 L2 30 L24 24 Z"/></svg>
    <h1 class="ab-name">Hi, I'm {about.nick}.</h1>
    <svg class="scribble" viewBox="0 0 340 16" preserveAspectRatio="none" style="max-width:300px"><path d="M4 11 q40 -9 80 -3 q50 7 96 -2 q56 -10 104 1 q30 6 52 -1"/></svg>
    <p class="ab-tag">{about.tag}</p>
  </header>

  <!-- ── top: polaroid + diary ── -->
  <section class="wall">
    <div class="wall-left">
      <figure class="polaroid rv">
        <span class="tape" style="top:-13px;left:50%;margin-left:-46px;transform:rotate(-4deg)"></span>
        <img src="/silky.jpg" alt="Silky" width="680" height="850" />
        <figcaption>me, mid-overthink</figcaption>
      </figure>

      <aside class="sticky rv">
        <h3>currently</h3>
        <ul>
          {now.map((n) => <li><span class="k">{n.k}</span><span class="v">{n.v}</span></li>)}
        </ul>
      </aside>

      <div class="prints rv">
        <figure class="print" style="transform:rotate(-2.2deg)">
          <span class="tape" style="top:-11px;left:50%;margin-left:-34px;transform:rotate(-5deg)"></span>
          <img src="/about/camera.webp" alt="a painted film camera" width="640" height="640" loading="lazy" decoding="async" />
          <figcaption>the enabler</figcaption>
        </figure>
        <figure class="print" style="transform:rotate(1.8deg)">
          <span class="tape" style="top:-11px;left:50%;margin-left:-34px;transform:rotate(4deg)"></span>
          <img src="/about/coffee.webp" alt="a painted cup of coffee, seen from above" width="640" height="640" loading="lazy" decoding="async" />
          <figcaption>cold. again.</figcaption>
        </figure>
      </div>
    </div>

    <article class="diary rv">
      <span class="tape" style="top:-13px;right:44px;transform:rotate(6deg)"></span>
      <h2>the long version</h2>
      {diary.map((p) => <p>{p}</p>)}
      <span class="sign">— {about.nick} ✷</span>
    </article>
  </section>

  <!-- ── favourites board (tap to reveal) ── -->
  <section class="favs">
    <div class="sec-head">
      <h2>a few of my favourite things</h2>
      <span class="line"></span>
    </div>
    <p class="favs-hint">tap any of them ↓</p>

    <div class="favs-grid">
      <button class="fav obj-btn" data-cat="smokes" aria-label="Silky's cigarettes">
        <img class="fp" src="/about/smokes.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
        <span class="lbl">smokes</span>
      </button>

      <button class="fav obj-btn" data-cat="drinks" aria-label="Silky's drinks">
        <img class="fp" src="/about/drinks.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
        <span class="lbl">drinks</span>
      </button>

      <button class="fav obj-btn" data-cat="books" aria-label="Silky's books">
        <svg class="fd" viewBox="0 0 100 100">
          <g fill="none" stroke="var(--blue)" stroke-width="3.6" stroke-linejoin="round"><rect x="22" y="60" width="60" height="15" rx="2"/><rect x="27" y="45" width="55" height="15" rx="2"/><rect x="17" y="30" width="58" height="15" rx="2"/></g>
          <g stroke="var(--pink)" stroke-width="3" stroke-linecap="round"><line x1="30" y1="66" x2="30" y2="69"/><line x1="35" y1="51" x2="35" y2="54"/><line x1="25" y1="36" x2="25" y2="39"/></g>
        </svg>
        <span class="lbl">books</span>
      </button>

      <button class="fav obj-btn" data-cat="music" aria-label="Silky's music">
        <img class="fp" src="/about/music.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
        <span class="lbl">on repeat</span>
      </button>

      <button class="fav obj-btn" data-cat="movies" aria-label="Silky's movies">
        <img class="fp" src="/about/movies.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
        <span class="lbl">movies</span>
      </button>

      <button class="fav obj-btn" data-cat="flowers" aria-label="Silky's flowers">
        <img class="fp" src="/about/flowers.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
        <span class="lbl">flowers</span>
      </button>
    </div>
  </section>

  <div class="ab-cta">
    <a class="read-cta" href="/#wall" style="display:inline-block;text-decoration:none">now read the diary →</a>
  </div>

  <!-- favourites data (hidden; cloned on tap) -->
  <div id="deskData" hidden>
    {Object.entries(favs).map(([cat, d]) => (
      <div class="dset" data-cat={cat}>
        <h3>{d.title}</h3>
        {d.note && <p class="dc-note">“{d.note}”</p>}
        <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
  </div>

  <!-- the note that flips up -->
  <div id="deskCard" class="desk-card" aria-hidden="true">
    <div class="dc-inner" role="dialog" aria-modal="true">
      <span class="tape" style="top:-12px;left:40px;transform:rotate(-5deg)"></span>
      <span class="tape" style="top:-12px;right:40px;transform:rotate(6deg)"></span>
      <button class="dc-close" type="button" aria-label="close">✕</button>
      <div class="dc-body"></div>
    </div>
  </div>

</main>

<script is:inline>
  (() => {
    const card = document.getElementById('deskCard');
    if (!card) return;
    const body = card.querySelector('.dc-body');
    const data = {};
    document.querySelectorAll('#deskData .dset').forEach((d) => { data[d.dataset.cat] = d.innerHTML; });
    let lastFocus = null;
    function open(cat, trigger) {
      if (!data[cat]) return;
      lastFocus = trigger || null; body.innerHTML = data[cat];
      card.classList.add('open'); card.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; card.querySelector('.dc-close').focus();
    }
    function close() {
      card.classList.remove('open'); card.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; if (lastFocus) lastFocus.focus();
    }
    document.querySelectorAll('.obj-btn').forEach((b) => b.addEventListener('click', () => open(b.dataset.cat, b)));
    card.addEventListener('click', (e) => { if (e.target === card || e.target.closest('.dc-close')) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && card.classList.contains('open')) close(); });
  })();
</script>

<style>
  #about { padding-bottom: 40px; }

  .ab-hero { padding: 44px 0 26px; position: relative; }
  .ab-hero .sticker { font-size: 1rem; margin-bottom: 18px; }
  .ab-name { font-family: var(--marker); font-weight: 700; color: var(--pink);
    font-size: clamp(2.8rem, 8vw, 5.2rem); line-height: .9; margin: 12px 0 0; text-shadow: 2px 2px 0 var(--blue); }
  .ab-tag { font-family: var(--hand); font-size: clamp(1rem, 2.4vw, 1.3rem); color: var(--blue); margin-top: 12px; transform: rotate(-.8deg); }

  /* ── wall: polaroid + diary ── */
  .wall { display: grid; grid-template-columns: 300px 1fr; gap: 46px; align-items: start; margin: 8px 0 74px; }
  .wall-left { display: flex; flex-direction: column; gap: 30px; }

  .polaroid { background: var(--card); padding: 15px 15px 18px; position: relative;
    box-shadow: 4px 12px 30px rgba(0,0,0,.2); transform: rotate(-2.6deg); }
  .polaroid img { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: 34% 24%; }
  .polaroid figcaption { font-family: var(--marker); font-weight: 700; font-size: 1.6rem; color: var(--ink); text-align: center; margin-top: 10px; }

  .sticky { background: #f7e58a; padding: 22px 24px; box-shadow: 3px 8px 20px rgba(0,0,0,.16); transform: rotate(1.4deg); }
  [data-theme="night"] .sticky { background: #d8c76a; }
  .sticky h3 { font-family: var(--sticker); text-transform: uppercase; font-size: 1.1rem; color: #3a2f10; letter-spacing: .04em; margin-bottom: 12px; transform: rotate(-1.5deg); }
  .sticky ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .sticky li { display: flex; flex-direction: column; }
  .sticky .k { font-family: var(--grotesk); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: #8a6a1a; }
  .sticky .v { font-family: var(--type); font-size: .92rem; color: #2a2410; line-height: 1.35; }

  .prints { display: flex; gap: 18px; }
  .print { position: relative; flex: 1; background: var(--card); padding: 9px 9px 6px;
    box-shadow: 3px 8px 20px rgba(0,0,0,.16); }
  .print img { display: block; width: 100%; height: auto; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
  .print figcaption { font-family: var(--hand); font-size: .88rem; color: var(--ink-soft); text-align: center; padding: 5px 0 3px; }

  .diary { position: relative; background: var(--card); padding: 40px 42px 34px;
    box-shadow: 0 14px 44px rgba(0,0,0,.16); transform: rotate(.4deg);
    background-image: repeating-linear-gradient(var(--card) 0 33px, color-mix(in srgb, var(--blue) 20%, transparent) 33px 34px);
    border-left: 3px solid color-mix(in srgb, var(--pink) 60%, transparent); }
  .diary h2 { font-family: var(--marker); font-weight: 700; font-size: clamp(1.9rem, 4vw, 2.7rem); color: var(--pink);
    text-shadow: 1.5px 1.5px 0 var(--blue); line-height: 1; margin-bottom: 20px; }
  .diary p { font-family: var(--type); font-size: 1rem; line-height: 34px; color: var(--ink); max-width: 62ch; }
  .diary .sign { display: block; font-family: var(--marker); font-weight: 700; font-size: 1.7rem; color: var(--blue); margin-top: 20px; transform: rotate(-2deg); }

  /* ── favourites board ── */
  .favs { margin: 0 0 30px; }
  .favs-hint { font-family: var(--hand); font-size: 1.05rem; color: var(--blue); margin: -22px 0 26px; transform: rotate(-.8deg); }
  .favs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }

  .fav { position: relative; background: var(--card); border: 1px solid rgba(0,0,0,.06); cursor: pointer;
    padding: 26px 18px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px;
    box-shadow: 3px 8px 22px rgba(0,0,0,.14); transition: transform .22s var(--ease), box-shadow .22s var(--ease); }
  .fav::before { content: ""; position: absolute; top: -11px; left: 50%; margin-left: -42px; width: 84px; height: 22px;
    background: var(--tape); transform: rotate(-3deg); box-shadow: 0 1px 4px rgba(0,0,0,.12); }
  .fav:nth-child(3n+1) { transform: rotate(-1.8deg); }
  .fav:nth-child(3n+2) { transform: rotate(1.2deg); }
  .fav:nth-child(3n)   { transform: rotate(-.6deg); }
  .fav:hover, .fav:focus-visible { transform: rotate(0) translateY(-7px) scale(1.03); box-shadow: 6px 16px 34px rgba(0,0,0,.22); outline: none; z-index: 4; }
  .fd { width: 74px; height: 74px; filter: url(#rough); }
  .fp { width: 108px; height: 108px; object-fit: cover; box-shadow: 0 1px 5px rgba(0,0,0,.15); }
  .lbl { font-family: var(--marker); font-weight: 700; font-size: 1.7rem; color: var(--ink); line-height: 1; transition: color .2s; }
  .fav:hover .lbl, .fav:focus-visible .lbl { color: var(--pink); }

  /* ── note card ── */
  .desk-card { position: fixed; inset: 0; z-index: 200; display: none; align-items: center; justify-content: center;
    background: rgba(18,16,26,.55); backdrop-filter: blur(3px); padding: 24px; }
  .desk-card.open { display: flex; }
  .dc-inner { position: relative; background: var(--card); width: min(420px, 92vw); padding: 40px 34px 34px;
    box-shadow: 0 24px 70px rgba(0,0,0,.5); transform: rotate(-1.2deg);
    background-image: repeating-linear-gradient(var(--card) 0 30px, color-mix(in srgb, var(--blue) 16%, transparent) 30px 31px);
    animation: pop .28s var(--ease); }
  @keyframes pop { from { transform: rotate(-1.2deg) scale(.85); opacity: 0; } to { transform: rotate(-1.2deg) scale(1); opacity: 1; } }
  .dc-close { position: absolute; top: 8px; right: 10px; background: var(--ink); color: var(--paper); border: 0;
    width: 30px; height: 30px; cursor: pointer; font-size: .9rem; line-height: 1; box-shadow: 2px 2px 0 rgba(0,0,0,.25); }
  .dc-close:hover { background: var(--pink); }
  .dc-body :global(h3) { font-family: var(--marker); font-weight: 700; font-size: 2.4rem; color: var(--pink);
    text-shadow: 1.5px 1.5px 0 var(--blue); line-height: .95; margin-bottom: 4px; }
  .dc-body :global(.dc-note) { font-family: var(--hand); font-size: 1rem; color: var(--blue); margin-bottom: 16px; }
  .dc-body :global(ul) { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .dc-body :global(li) { font-family: var(--type); font-size: 1rem; color: var(--ink); line-height: 1.4; padding-left: 26px; position: relative; }
  .dc-body :global(li)::before { content: "✦"; position: absolute; left: 0; top: 1px; color: var(--pink); }

  .ab-cta { text-align: center; padding: 20px 0; }

  /* ── responsive ── */
  @media (max-width: 820px) {
    .wall { grid-template-columns: 1fr; gap: 34px; }
    .wall-left { flex-direction: row; flex-wrap: wrap; gap: 22px; }
    .polaroid { max-width: 280px; }
    .sticky { flex: 1; min-width: 200px; }
    .prints { flex: 1 1 100%; max-width: 380px; }
    .diary { padding: 30px 26px; }
  }
  @media (max-width: 560px) {
    .favs-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .wall-left { flex-direction: column; }
    .polaroid { margin: 0 auto; }
    .prints { margin: 0 auto; width: 100%; }
  }
  @media (max-width: 680px) { .ab-hide { display: none; } }
</style>
</Base>
